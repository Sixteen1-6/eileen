{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo xtask *)",
      "Bash(cargo fmt *)"
    ],
    "deny": [
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo run:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo bench:*)",
      "Bash(cargo fuzz:*)",
      "Bash(cargo insta:*)",
      "Bash(cargo mutants:*)",
      "Bash(cargo install:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo update:*)",
      "Bash(cargo rustc:*)",
      "Bash(cargo rustdoc:*)",
      "Bash(cargo fix:*)",
      "Bash(cargo miri:*)",
      "Bash(cargo llvm-cov:*)",
      "Bash(cargo package:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo b:*)",
      "Bash(cargo c:*)",
      "Bash(cargo d:*)",
      "Bash(cargo t:*)",
      "Bash(cargo r:*)",
      "Bash(cargo +*)",
      "Bash(cargo -*)",
      "Bash(cargo.exe *)",
      "Bash(cargo xtask * --release*)",
      "Bash(cargo xtask * -r)",
      "Bash(cargo xtask * -r *)",
      "Bash(cargo xtask * --profile release*)",
      "Bash(cargo xtask * --profile=release*)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.codex/auth.json)",
      "Read(~/.config/gh/**)",
      "Read(~/AppData/Roaming/GitHub CLI/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.npmrc)",
      "Read(~/AppData/Roaming/Microsoft/Credentials/**)",
      "Read(~/AppData/Local/Microsoft/Credentials/**)"
    ]
  }
}
