# Synthetic: an Ubuntu 24.04 desktop with a Core i7-9700K (8 cores, no SMT, one core type),
# 32 GB, its UHD 630 (i915) and an RTX 4070 on NVIDIA's own driver, ext4 on LVM on a hard
# disk beside an NVMe disk, no battery and one monitor on the NVIDIA card. The NVIDIA
# information file's GPU UUID is zeroed: the probe keeps only its Model line.

proc/sys/kernel/osrelease = 6.8.0-87-generic

<<< etc/os-release
PRETTY_NAME="Ubuntu 24.04.3 LTS"
NAME="Ubuntu"
VERSION_ID="24.04"
ID=ubuntu
ID_LIKE=debian
>>>

<<< proc/meminfo
MemTotal:       32767264 kB
MemFree:        25307136 kB
MemAvailable:   29102448 kB
SwapTotal:       2097148 kB
SwapFree:        2097148 kB
CommitLimit:    18480780 kB
Committed_AS:    7423104 kB
>>>

