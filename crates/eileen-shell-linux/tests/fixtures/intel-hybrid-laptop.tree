# Synthetic: a laptop shaped like the owner's, a Core Ultra 7 155H (6 performance cores with two
# threads each, 8 efficient and 2 low-power efficient cores, 22 threads) with 16 GB, under
# Ubuntu 26.04. Its Arc GPU (i915) and NPU (intel_vpu), an NVMe disk, a discharging battery,
# the power saver on, a Bluetooth mouse's battery, and the built-in panel as the only display.
# The kernel also publishes cpu_capacity here (three values); the hybrid PMU lists win, giving
# the two classes Windows reports.

proc/sys/kernel/osrelease = 7.0.0-14-generic

<<< etc/os-release
PRETTY_NAME="Ubuntu 26.04 LTS"
NAME="Ubuntu"
VERSION_ID="26.04"
VERSION="26.04 LTS (Resolute Raccoon)"
ID=ubuntu
ID_LIKE=debian
>>>

<<< proc/meminfo
