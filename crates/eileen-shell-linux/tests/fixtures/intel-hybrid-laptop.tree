battery_aware=true
>>>

# The memory sample: paging counters, the overcommit policy and a process tree. Eileen (5000)
# and everything under it (speech, a Claude session and its node child, the biggest process
# of all) are Eileen's own; the largest other process is the browser.
<<< proc/vmstat
pgpgin 812345
pgpgout 402211
pswpin 0
pswpout 0
pgfault 91234567
pgmajfault 48213
>>>
proc/sys/vm/overcommit_memory = 0
