# Synthetic: a Fedora 43 desktop with a Ryzen 7 7700X (Zen 4: AVX-512 with VNNI; SMT siblings
# numbered n and n+8), 64 GB, the processor's own Radeon (a 512 MB carve-out) and an RX 7900 XTX
# (24 GB), btrfs subvolumes on NVMe with an anonymous device number, a hard disk and zram swap,
# a mouse's battery, and three monitors of which the user turned one off. Fedora keeps
# os-release under /usr/lib and the PCI ID database under /usr/share/hwdata.

proc/sys/kernel/osrelease = 6.17.4-300.fc43.x86_64

<<< usr/lib/os-release
NAME="Fedora Linux"
VERSION="43 (Workstation Edition)"
ID=fedora
VERSION_ID=43
PRETTY_NAME="Fedora Linux 43 (Workstation Edition)"
VARIANT_ID=workstation
>>>

