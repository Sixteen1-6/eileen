# Synthetic: Ubuntu 26.04 desktop in a QEMU/KVM virtual machine, the way a Windows developer
# first tries Eileen on Linux: 4 virtual CPUs passing the host's Core Ultra 7 155H through
# (no hybrid PMU lists inside the guest), 8 GB, a virtio GPU that only displays, ext4 on LVM
# on QEMU's SCSI disk, no battery and one virtual display.

proc/sys/kernel/osrelease = 7.0.0-14-generic

<<< etc/os-release
PRETTY_NAME="Ubuntu 26.04 LTS"
NAME="Ubuntu"
VERSION_ID="26.04"
ID=ubuntu
ID_LIKE=debian
>>>

<<< proc/meminfo
MemTotal:        8130124 kB
MemFree:         5120344 kB
MemAvailable:    6321908 kB
SwapTotal:       4194300 kB
SwapFree:        4194300 kB
CommitLimit:     8259360 kB
Committed_AS:    3480120 kB
>>>

<<< proc/cpuinfo
processor	: 0
vendor_id	: GenuineIntel
model name	: Intel(R) Core(TM) Ultra 7 155H
flags		: fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush mmx fxsr sse sse2 ss syscall nx pdpe1gb rdtscp lm constant_tsc rep_good nopl xtopology cpuid tsc_known_freq pni pclmulqdq ssse3 fma cx16 sse4_1 sse4_2 movbe popcnt aes xsave avx f16c rdrand hypervisor lahf_lm abm fsgsbase bmi1 avx2 smep bmi2 erms invpcid rdseed adx smap clflushopt clwb sha_ni xsaveopt xsavec xgetbv1 xsaves avx_vnni arat umip gfni vaes vpclmulqdq rdpid movdiri movdir64b fsrm md_clear serialize

processor	: 1
processor	: 2
processor	: 3
>>>

sys/devices/system/cpu/online = 0-3
sys/devices/system/cpu/cpu{0-3}/topology/core_cpus_list = $n

sys/class/drm/version = drm 1.1.0 20060810
<<< sys/class/drm/card0/device/uevent
DRIVER=virtio_gpu
MODALIAS=virtio:d00000010v00001AF4
>>>
sys/class/drm/card0-Virtual-1/status = connected
sys/class/drm/card0-Virtual-1/enabled = enabled

sys/block/dm-0/dev = 252:0
sys/block/dm-0/queue/rotational = 1
sys/block/dm-0/dm/name = ubuntu--vg-ubuntu--lv
sys/block/dm-0/slaves/sda3/dev = 8:3
sys/block/sda/dev = 8:0
sys/block/sda/queue/rotational = 1
sys/block/sda/device/vendor = QEMU
sys/block/sda/device/model = QEMU HARDDISK
sys/block/sda/sda1/dev = 8:1
sys/block/sda/sda2/dev = 8:2
sys/block/sda/sda3/dev = 8:3
sys/block/sr0/dev = 11:0
sys/block/sr0/queue/rotational = 1
