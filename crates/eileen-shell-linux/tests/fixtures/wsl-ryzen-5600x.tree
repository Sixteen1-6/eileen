# Recorded on 2026-10-21 under WSL2 (Ubuntu 24.04.4, kernel 6.18.33.2) on an AMD Ryzen 5 5600X
# with 16 GB and an RTX 3060, trimmed to the files the probe reads. /proc/cpuinfo keeps its
# first processor in full and the other eleven as their `processor` lines; /proc/self/mountinfo
# keeps the root's line. WSL lists no DRM card, power supply or display connector.

proc/sys/kernel/osrelease = 6.18.33.2-microsoft-standard-WSL2

