---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "NoArgs": {
      "description": "The arguments of a tool that takes none: an empty object.",
      "type": "object"
    },
    "ObservesRule": {
      "description": "The observed-source class of what an op returns (section 2.12's observed-read table).",
      "oneOf": [
        {
          "const": "none",
          "description": "Nothing from outside Eileen.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Always this source.",
          "properties": {
            "fixed": {
              "$ref": "#/$defs/ObservedSource"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        },
        {
          "const": "by_target",
          "description": "By the window or app it targets.",
          "type": "string"
        },
        {
          "const": "by_args",
          "description": "By its arguments.",
          "type": "string"
        },
        {
          "const": "by_jobs",
          "description": "By the jobs it lists.",
          "type": "string"
        }
      ]
    },
    "OpSpec": {
      "description": "One op of a tool. `op` is the selector variant's `snake_case` tag (`timeline_info`,\n`status`, `snap`), the same tag recipes, checks and trajectories hold.",
      "properties": {
        "artifact_only": {
          "description": "It only writes new files into the job's temp folder, so an extra call does not break\nshadow agreement (section 2.10 item 7).",
          "type": "boolean"
        },
        "idempotent": {
          "description": "A recipe may retry it once.",
          "type": "boolean"
        },
        "inverse": {
          "description": "How the journal reverses it; the op's output carries its inputs.",
          "type": [
            "string",
            "null"
          ]
        },
        "needs_foreground": {
          "description": "It takes the input lock and a lease.",
          "type": "boolean"
        },
        "observes": {
          "$ref": "#/$defs/ObservesRule",
          "description": "The class of everything the op returns, its verification hint included."
        },
        "op": {
          "description": "The op's tag.",
          "type": "string"
        },
        "output_schema": {
          "description": "From the op's result struct; required for any op a recipe may call or point into."
        },
        "preview_before": {
          "description": "Show the target or crop and ask before running (hard-to-undo edits).",
          "type": "boolean"
        },
        "read_only": {
          "description": "Usable as a recipe check (tier 0 only).",
          "type": "boolean"
        },
        "tier": {
          "$ref": "#/$defs/TierRule",
          "description": "Its tier."
        }
      },
      "required": [
        "op",
        "tier",
        "read_only",
        "idempotent",
        "artifact_only",
        "needs_foreground",
        "preview_before",
        "observes"
      ],
      "type": "object"
    },
    "TierRule": {
      "description": "How an op's tier is decided.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Always this tier.",
          "properties": {
            "fixed": {
              "$ref": "#/$defs/Tier"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        },
        {
          "const": "by_args",
          "description": "The server computes it per call.",
          "type": "string"
        }
      ]
    },
    "ToolSpec": {
      "description": "One tool, as a connector's manifest declares it.",
      "properties": {
        "connector": {
          "$ref": "#/$defs/ConnectorId",
          "description": "The connector that serves it."
        },
        "description": {
          "description": "At most 600 characters, written for the model.",
          "type": "string"
        },
        "input_schema": {
          "description": "Generated by schemars from the argument struct."
        },
        "name": {
          "$ref": "#/$defs/ToolName",
          "description": "Its name."
        },
        "ops": {
          "description": "One entry per op; one entry named `\"\"` for tools without ops.",
          "items": {
            "$ref": "#/$defs/OpSpec"
          },
          "type": "array"
        },
        "rung": {
          "$ref": "#/$defs/Rung",
          "description": "The route this tool represents."
        },
        "schema_hash": {
          "description": "BLAKE3 of `input_schema` and every op's `output_schema`; recipes record it.",
          "type": "string"
        },
        "selector": {
          "description": "`op` or `action`: the argument field whose enum variant is the op; `None` for tools\nwithout ops.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "How long a call may take.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "toolset": {
          "$ref": "#/$defs/Toolset",
          "description": "Its home toolset."
        }
      },
      "required": [
        "name",
        "connector",
        "toolset",
        "description",
        "ops",
        "timeout_ms",
        "input_schema",
        "schema_hash",
        "rung"
      ],
      "type": "object"
    }
  },
  "toolsets": {
    "act": [
      "desktop_launch_app",
      "desktop_window",
      "desktop_volume",
      "apps_open_url",
      "apps_open_uri",
      "apps_open_path",
      "apps_media",
