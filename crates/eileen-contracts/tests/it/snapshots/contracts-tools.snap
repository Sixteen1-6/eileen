      "desktop_windows",
      "desktop_tree",
      "desktop_screenshot",
      "desktop_click_element",
      "desktop_set_value",
      "desktop_type_text",
      "desktop_press_keys",
      "desktop_click",
      "desktop_scroll",
      "desktop_drag",
      "desktop_window",
      "desktop_launch_app",
      "desktop_wait_for",
      "desktop_selection",
      "desktop_insert_text",
