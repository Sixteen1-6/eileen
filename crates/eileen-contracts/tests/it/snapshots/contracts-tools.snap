---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "CallLine": {
      "description": "A tool call, as the shim forwards it.",
      "properties": {
        "args": {
          "description": "Its arguments, as the model sent them.",
          "x-eileen-text": "untrusted"
        },
        "id": {
          "description": "The shim's number for the call; its result carries the same.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "meta": {
          "$ref": "#/$defs/CallMeta",
          "description": "What the shim passes on from the request's `_meta`."
        },
        "tool": {
          "$ref": "#/$defs/ToolName",
          "description": "The tool."
        }
      },
      "required": [
        "id",
        "tool",
        "args",
        "meta"
      ],
      "type": "object"
    },
    "CallMeta": {
      "description": "The part of an MCP request's `_meta` the shim passes on.",
      "properties": {
        "traceparent": {
          "description": "The caller's W3C `traceparent`, when it sent one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DispatcherLine": {
      "description": "A line the dispatcher writes back to a shim.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The answer to a hello: the tools for the role, which `tools/list` shows.",
          "properties": {
            "welcome": {
              "$ref": "#/$defs/Welcome"
            }
          },
          "required": [
            "welcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A call's result.",
          "properties": {
            "result": {
              "$ref": "#/$defs/ResultLine"
            }
          },
          "required": [
            "result"
          ],
          "type": "object"
        }
      ]
    },
    "NoArgs": {
      "description": "The arguments of a tool that takes none: an empty object.",
      "type": "object"
    },
    "ObservesRule": {
      "description": "The observed-source class of what an op returns (section 2.12's observed-read table).",
      "oneOf": [
        {
          "const": "none",
          "description": "Nothing from outside Eileen.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Always this source.",
          "properties": {
            "fixed": {
              "$ref": "#/$defs/ObservedSource"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        },
        {
          "const": "by_target",
          "description": "By the window or app it targets.",
          "type": "string"
        },
        {
          "const": "by_args",
          "description": "By its arguments.",
          "type": "string"
        },
        {
          "const": "by_jobs",
          "description": "By the jobs it lists.",
          "type": "string"
        }
      ]
    },
    "OpSpec": {
      "description": "One op of a tool. `op` is the selector variant's `snake_case` tag (`timeline_info`,\n`status`, `snap`), the same tag recipes, checks and trajectories hold.",
      "properties": {
        "artifact_only": {
          "description": "It only writes new files into the job's temp folder, so an extra call does not break\nshadow agreement (section 2.10 item 7).",
          "type": "boolean"
        },
        "idempotent": {
          "description": "A recipe may retry it once.",
          "type": "boolean"
        },
        "inverse": {
          "description": "How the journal reverses it; the op's output carries its inputs.",
          "type": [
            "string",
            "null"
          ]
        },
        "needs_foreground": {
          "description": "It takes the input lock and a lease.",
          "type": "boolean"
        },
        "observes": {
          "$ref": "#/$defs/ObservesRule",
          "description": "The class of everything the op returns, its verification hint included."
        },
        "op": {
          "description": "The op's tag.",
          "type": "string"
        },
        "output_schema": {
          "description": "From the op's result struct; required for any op a recipe may call or point into."
        },
        "preview_before": {
          "description": "Show the target or crop and ask before running (hard-to-undo edits).",
          "type": "boolean"
        },
        "read_only": {
          "description": "Usable as a recipe check (tier 0 only).",
          "type": "boolean"
        },
        "tier": {
          "$ref": "#/$defs/TierRule",
          "description": "Its tier."
        }
      },
      "required": [
        "op",
        "tier",
        "read_only",
        "idempotent",
        "artifact_only",
        "needs_foreground",
        "preview_before",
        "observes"
      ],
      "type": "object"
    },
    "ResultLine": {
      "description": "A call's result, as the shim returns it to the model.",
      "properties": {
        "content": {
          "description": "What the model sees.",
          "items": {
            "$ref": "#/$defs/Content"
          },
          "type": "array"
        },
        "id": {
          "description": "The call's number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "Whether the call failed.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "content",
        "is_error"
      ],
      "type": "object"
    },
    "ShimHello": {
      "description": "A shim's first line.",
      "properties": {
        "role": {
          "$ref": "#/$defs/ShimRole",
          "description": "The role the session was started with."
        },
        "token": {
          "$ref": "#/$defs/SessionToken",
          "description": "The session's token, from the generated MCP config."
        },
        "v": {
          "description": "The protocol version, [`DISPATCH_VERSION`].",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "v",
        "token",
        "role"
      ],
      "type": "object"
    },
    "ShimLine": {
      "description": "A line `eileen-shim` writes to the dispatcher pipe (section 3.3.9): JSON, one per line. The\nfirst is always a [`ShimHello`]; the dispatcher checks its token and the caller's process\nbefore it answers, and closes the pipe on a wrong one.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Who is calling.",
          "properties": {
            "hello": {
              "$ref": "#/$defs/ShimHello"
            }
          },
          "required": [
            "hello"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A tool call.",
          "properties": {
            "call": {
              "$ref": "#/$defs/CallLine"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        }
      ]
    },
    "TierRule": {
      "description": "How an op's tier is decided.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Always this tier.",
          "properties": {
            "fixed": {
              "$ref": "#/$defs/Tier"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        },
        {
          "const": "by_args",
          "description": "The server computes it per call.",
          "type": "string"
        }
      ]
    },
    "ToolSpec": {
      "description": "One tool, as a connector's manifest declares it.",
      "properties": {
        "connector": {
          "$ref": "#/$defs/ConnectorId",
          "description": "The connector that serves it."
        },
        "description": {
          "description": "At most 600 characters, written for the model.",
          "type": "string"
        },
        "input_schema": {
          "description": "Generated by schemars from the argument struct."
        },
        "name": {
          "$ref": "#/$defs/ToolName",
          "description": "Its name."
        },
        "ops": {
          "description": "One entry per op; one entry named `\"\"` for tools without ops.",
          "items": {
            "$ref": "#/$defs/OpSpec"
          },
          "type": "array"
        },
        "rung": {
          "$ref": "#/$defs/Rung",
          "description": "The route this tool represents."
        },
        "schema_hash": {
          "description": "BLAKE3 of `input_schema` and every op's `output_schema`; recipes record it.",
          "type": "string"
        },
        "selector": {
          "description": "`op` or `action`: the argument field whose enum variant is the op; `None` for tools\nwithout ops.",
          "type": [
            "string",
            "null"
          ]
        },
        "timeout_ms": {
          "description": "How long a call may take.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "toolset": {
          "$ref": "#/$defs/Toolset",
          "description": "Its home toolset."
        }
      },
      "required": [
        "name",
        "connector",
        "toolset",
        "description",
        "ops",
        "timeout_ms",
        "input_schema",
        "schema_hash",
        "rung"
      ],
      "type": "object"
    },
    "Welcome": {
      "description": "The tools the dispatcher serves to one role.",
      "properties": {
        "tools": {
          "description": "The role's tools.",
          "items": {
            "$ref": "#/$defs/ToolSpec"
          },
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "type": "object"
    }
  },
  "toolsets": {
    "act": [
      "desktop_launch_app",
      "desktop_window",
      "desktop_volume",
      "apps_open_url",
      "apps_open_uri",
      "apps_open_path",
      "apps_media",
      "apps_recent",
      "apps_resolve"
    ],
    "apps": [
      "apps_media",
      "apps_open_url",
      "apps_open_uri",
      "apps_open_path",
      "apps_resolve",
      "apps_office",
      "apps_explorer",
      "apps_recent",
      "apps_image",
      "apps_photoshop"
    ],
    "brain": [
      "jobs_dispatch",
      "jobs_status",
      "jobs_control",
      "desktop_state",
      "desktop_look",
      "capabilities",
      "settings_get",
      "settings_propose",
      "settings_apply",
      "settings_undo",
      "learned_query",
      "learned_forget",
      "learned_correct",
      "ledger_search",
      "scenario_save",
      "ask_user",
      "hud_show"
    ],
    "desktop": [
      "desktop_state",
      "desktop_look",
      "desktop_windows",
      "desktop_tree",
      "desktop_screenshot",
      "desktop_click_element",
      "desktop_set_value",
      "desktop_type_text",
      "desktop_press_keys",
      "desktop_click",
      "desktop_scroll",
      "desktop_drag",
      "desktop_window",
      "desktop_launch_app",
      "desktop_wait_for",
      "desktop_selection",
      "desktop_insert_text",
      "desktop_volume"
    ],
    "dev": [
      "dev_codemap",
      "dev_crate_doc",
      "dev_event_map",
      "dev_trace_get",
      "dev_logs_query",
      "dev_incident_list",
      "dev_incident_read",
      "dev_replay_core",
      "dev_scenario_list"
    ],
    "learn": [
      "learn_trajectory_read",
      "learn_skill_list",
      "learn_skill_read",
      "learn_skill_history",
      "learn_skill_propose",
      "learn_fact_propose"
    ],
    "session": [
      "session_status",
      "session_jobs",
      "session_say",
      "session_mute",
      "session_handoff",
      "session_ask",
      "session_skills"
    ],
    "worker": [
      "ask_user",
      "report",
      "routes_lookup",
      "routes_propose",
      "approve"
    ]
  }
}
