    ],
    "dev": [
      "dev_codemap",
      "dev_crate_doc",
      "dev_event_map",
      "dev_trace_get",
      "dev_logs_query",
      "dev_incident_list",
      "dev_incident_read",
      "dev_replay_core",
      "dev_scenario_list"
    ],
    "learn": [
      "learn_trajectory_read",
      "learn_skill_list",
      "learn_skill_read",
      "learn_skill_history",
      "learn_skill_propose",
      "learn_fact_propose"
    ],
    "session": [
      "session_status",
      "session_jobs",
      "session_say",
