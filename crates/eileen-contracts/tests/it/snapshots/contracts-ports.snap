          "minimum": 0,
          "type": "integer"
        },
        "fillers_removed": {
          "description": "Fillers removed.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "The text to insert.",
          "type": "string",
          "x-eileen-text": "personal"
        }
      },
      "required": [
        "text",
        "fillers_removed",
        "corrections"
      ],
      "type": "object"
    }
  }
