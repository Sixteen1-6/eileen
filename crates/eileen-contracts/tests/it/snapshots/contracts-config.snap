---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "AnnounceMode": {
      "description": "How an event is announced.",
      "oneOf": [
        {
          "const": "interrupt",
          "description": "Speak at once, interrupting.",
          "type": "string"
        },
        {
          "const": "when_idle",
          "description": "Speak when the conversation is idle.",
          "type": "string"
        },
        {
          "const": "silent",
          "description": "Do not speak.",
          "type": "string"
        },
        {
          "const": "hud_only",
          "description": "Show on the HUD only.",
          "type": "string"
        }
      ]
    },
    "AnnouncementsConfig": {
      "description": "How each event kind is announced.",
      "properties": {
        "events": {
          "additionalProperties": {
            "$ref": "#/$defs/AnnounceMode"
          },
          "default": {},
          "description": "Per dotted event name.",
          "type": "object"
        },
        "job_kinds": {
          "additionalProperties": {
            "$ref": "#/$defs/AnnounceMode"
          },
          "default": {},
          "description": "Per job kind, overriding the event's mode.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "AnticipationConfig": {
      "description": "Anticipated deep answers.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Whether it is on.",
          "type": "boolean"
        },
        "max_plan_pct": {
          "default": 50,
          "description": "Only below this plan usage, percent.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ApplyMode": {
      "description": "When a setting change takes effect.",
      "oneOf": [
        {
          "const": "next_turn",
          "description": "From the next turn.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "At once.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "After a component restarts.",
          "properties": {
            "restart": {
              "$ref": "#/$defs/Component"
            }
          },
          "required": [
            "restart"
          ],
          "type": "object"
        }
      ]
    },
    "ApprovalsConfig": {
      "description": "Approvals.",
      "properties": {
        "action_word_tier2": {
          "default": true,
          "description": "Tier 2 needs the action word by voice.",
          "type": "boolean"
        },
        "deadline_min": {
          "default": 30,
          "description": "When an open question is declined, minutes.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "hook_hold_s": {
          "default": 120,
          "description": "How long a hook waits for an answer, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "voice_window_s": {
          "default": 20,
          "description": "How long a question can be answered by voice, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "AssistantConfig": {
      "description": "The assistant's name and manner.",
      "properties": {
        "humor": {
          "$ref": "#/$defs/Humor",
          "default": "light",
          "description": "How playful it is."
        },
        "name": {
          "default": "Eileen",
          "description": "The name it answers to; a change runs the `NameRecognisable` check.",
          "type": "string"
        },
        "personality": {
          "default": "",
          "description": "Free text, at most 400 characters.",
          "type": "string"
        },
        "verbosity": {
          "$ref": "#/$defs/Verbosity",
          "default": "normal",
          "description": "How much it says."
        }
      },
      "type": "object"
    },
    "AutoOr_uint32": {
      "anyOf": [
        {
          "const": "auto"
        },
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      ]
    },
    "BackendChoice": {
      "description": "A backend and a model name.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/Route",
          "description": "The route."
        },
        "model": {
          "description": "A name from `models`, or a full id.",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model"
      ],
      "type": "object"
    },
    "CheckKind": {
      "description": "A check a setting change runs before it applies.",
      "oneOf": [
        {
          "const": "name_recognisable",
          "description": "The recognizer can pick the new name out of speech.",
          "type": "string"
        },
        {
          "const": "hotkey_free",
          "description": "No other app owns the hotkey.",
          "type": "string"
        },
        {
          "const": "voice_realtime",
          "description": "The voice renders faster than real time.",
          "type": "string"
        },
        {
          "const": "brain_benchmark",
          "description": "The brain benchmark passes for the new backend.",
          "type": "string"
        },
        {
          "const": "none",
          "description": "No check.",
          "type": "string"
        }
      ]
    },
    "CheckResult": {
      "description": "One check's result.",
      "properties": {
        "detail": {
          "description": "What it found, in one sentence.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CheckKind",
          "description": "The check."
        },
        "passed": {
          "description": "Whether it passed.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "passed",
        "detail"
      ],
      "type": "object"
    },
    "ClaudePluginConfig": {
      "description": "The `eileen` Claude plugin.",
      "properties": {
        "share_skills": {
          "default": false,
          "description": "Offer learned skills to the owner's own sessions.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Component": {
      "description": "A component a setting change restarts.",
      "oneOf": [
        {
          "const": "speech",
          "description": "The speech process.",
          "type": "string"
        },
        {
          "const": "hud",
          "description": "The HUD.",
          "type": "string"
        },
        {
          "const": "harness",
          "description": "The harness and its sessions.",
          "type": "string"
        },
        {
          "const": "desktop",
          "description": "The desktop sidecar.",
          "type": "string"
        },
        {
          "const": "apps",
          "description": "The apps sidecar.",
          "type": "string"
        },
        {
          "const": "shell",
          "description": "The shell (tray and hotkeys).",
          "type": "string"
        }
      ]
    },
    "Config": {
      "description": "The whole configuration.",
      "properties": {
        "announcements": {
          "$ref": "#/$defs/AnnouncementsConfig",
          "default": {
            "events": {},
            "job_kinds": {}
          },
          "description": "How each event kind is announced."
        },
        "anticipation": {
          "$ref": "#/$defs/AnticipationConfig",
          "default": {
            "enabled": false,
            "max_plan_pct": 50
          },
          "description": "Anticipated deep answers."
        },
        "approvals": {
          "$ref": "#/$defs/ApprovalsConfig",
          "default": {
            "action_word_tier2": true,
            "deadline_min": 30,
            "hook_hold_s": 120,
            "voice_window_s": 20
          },
          "description": "Approvals."
        },
        "assistant": {
          "$ref": "#/$defs/AssistantConfig",
          "default": {
            "humor": "light",
            "name": "Eileen",
            "personality": "",
            "verbosity": "normal"
          },
          "description": "The assistant's name and manner."
        },
        "claude_plugin": {
          "$ref": "#/$defs/ClaudePluginConfig",
          "default": {
            "share_skills": false
          },
          "description": "The `eileen` Claude plugin."
        },
        "conversation": {
          "$ref": "#/$defs/ConversationConfig",
          "default": {
            "addressee_min_points": 2,
            "alone_scoring": true,
            "follow_up_s": 8,
            "level_margin_db": 6,
            "window_s": 45
          },
          "description": "The conversation window and the addressee score."
        },
        "desktop": {
          "$ref": "#/$defs/DesktopConfig",
          "default": {
            "lease_idle_s": 5,
            "visible_intent_ms": 400,
            "web_tree": true
          },
          "description": "Desktop control."
        },
        "dictation": {
          "$ref": "#/$defs/DictationConfig",
          "default": {
            "categories": {},
            "key": null,
            "languages": [],
            "polish": true
          },
          "description": "Dictation."
        },
        "first_run": {
          "$ref": "#/$defs/FirstRunConfig",
          "default": {
            "done": false,
            "max_clone_ttfa_ms": 3000
          },
          "description": "The first run."
        },
        "fleet": {
          "$ref": "#/$defs/FleetConfig",
          "default": {
            "mode": "recorded",
            "opt_in": false,
            "schedule": null,
            "turn_budget": 0,
            "upload": false
          },
          "description": "The test fleet."
        },
        "flight": {
          "$ref": "#/$defs/FlightConfig",
          "default": {
            "minutes": 10
          },
          "description": "The flight recorder."
        },
        "focus": {
          "$ref": "#/$defs/FocusConfig",
          "default": {
            "quiet_during_calls": true,
            "quiet_full_screen": true,
            "quiet_recording": true
          },
          "description": "When Eileen keeps quiet."
        },
        "hotkeys": {
          "$ref": "#/$defs/HotkeysConfig",
          "default": {
            "approve": null,
            "deny": null,
            "dictation": null,
            "hands_off": null,
            "mute": "ctrl+alt+m",
            "report": "ctrl+alt+shift+b"
          },
          "description": "Hotkeys."
        },
        "hud": {
          "$ref": "#/$defs/HudConfig",
          "default": {
            "corner": "bottom_right",
            "opacity_pct": 90,
            "scale_pct": 100,
            "show_transcript": true,
            "suggestions": true
          },
          "description": "The HUD."
        },
        "incidents": {
          "$ref": "#/$defs/IncidentsConfig",
          "default": {
            "keep_days": 30,
            "max_mb": 1024
          },
          "description": "Incident bundles."
        },
        "learning": {
          "$ref": "#/$defs/LearningConfig",
          "default": {
            "distill": "claude",
            "enabled": true,
            "ladder": {
              "archive_idle_days": 30,
              "demote_failures_in_last5": 2,
              "light": {
                "l2_distinct_slot_values": 1,
                "l2_successes": 1,
                "l3_agreeing_shadows": 1,
                "l4_clean_pct_last_20": 0,
                "l4_clean_replays": 3
              },
              "standard": {
                "l2_distinct_slot_values": 2,
                "l2_successes": 3,
                "l3_agreeing_shadows": 3,
                "l4_clean_pct_last_20": 95,
                "l4_clean_replays": 10
              }
            },
            "librarian_max_plan_pct": 50,
            "phrasing_min_similarity": 0.85,
            "phrasing_paraphrase_uses": 2,
            "regret_window_s": 120,
            "snapshot_k": 12
          },
          "description": "The learning loop."
        },
        "logging": {
          "$ref": "#/$defs/LoggingConfig",
          "default": {
            "keep_days": 14,
            "level": "info"
          },
          "description": "Logs."
        },
        "mcp": {
          "$ref": "#/$defs/McpConfig",
          "default": {
            "servers": {}
          },
          "description": "Approved third-party MCP servers."
        },
        "memory": {
          "$ref": "#/$defs/MemoryConfig",
          "default": {
            "max_build_heavy_jobs": 1,
            "max_paging_kb_s": "auto",
            "pool_computer_use": 1,
            "pool_deep": 1,
            "pool_order": [
              "deep",
              "computer_use"
            ],
            "profile": "auto",
            "queue_ask_min": 10,
            "reserve_mb": "auto",
            "worker_job_limit_mb": 0
          },
          "description": "Memory admission and the pools."
        },
        "permissions": {
          "$ref": "#/$defs/PermissionsConfig",
          "default": {
            "desktop_apps": [],
            "grants": [],
            "private_apps": [],
            "uri_schemes": []
          },
          "description": "Standing grants and app permissions."
        },
        "privacy": {
          "$ref": "#/$defs/PrivacyConfig",
          "default": {
            "keep_unaddressed": false,
            "ledger_days": 14,
            "location": null,
            "off_the_record": false
          },
          "description": "Privacy."
        },
        "recording": {
          "$ref": "#/$defs/RecordingConfig",
          "default": {
            "audio": false,
            "keep_days": 7,
            "max_mb": 2048
          },
          "description": "Recordings."
        },
        "routing": {
          "$ref": "#/$defs/RoutingConfig",
          "default": {
            "brain": {
              "backend": "claude",
              "model": "fast"
            },
            "deep": {
              "backend": "claude",
              "model": "strong"
            },
            "fallback_brain": {
              "backend": "claude",
              "model": "fast"
            },
            "hot_spare": true,
            "kinds": {},
            "models": {
              "fast": "haiku",
              "mid": "sonnet",
              "strong": "opus"
            },
            "recycle": {
              "context_tokens": 60000
            },
            "speculative": false
          },
          "description": "Models, backends and routes."
        },
        "speech": {
          "$ref": "#/$defs/SpeechConfig",
          "default": {
            "asr": null,
            "low_memory_models": false,
            "pin_working_set": false,
            "turn": null,
            "vad": null
          },
          "description": "Speech engines."
        },
        "voice": {
          "$ref": "#/$defs/VoiceConfig",
          "default": {
            "announcements": null,
            "engines": {},
            "fallback": null,
            "live": null,
            "narration": null,
            "rate_pct": 100,
            "watermark_exports": false
          },
          "description": "Voices."
        }
      },
      "type": "object"
    },
    "ConfigGrant": {
      "description": "A grant that lasts.",
      "properties": {
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The logged decision, required for tier 2."
        },
        "matcher": {
          "$ref": "#/$defs/GrantMatcher",
          "description": "What it matches."
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "The highest tier it allows."
        }
      },
      "required": [
        "matcher",
        "tier"
      ],
      "type": "object"
    },
    "ConversationConfig": {
      "description": "The conversation window and the addressee score.",
      "properties": {
        "addressee_min_points": {
          "default": 2,
          "description": "The points an unnamed utterance needs to be addressed.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "alone_scoring": {
          "default": true,
          "description": "Score unnamed speech when the user is alone.",
          "type": "boolean"
        },
        "follow_up_s": {
          "default": 8,
          "description": "How long an unnamed follow-up counts, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "level_margin_db": {
          "default": 6,
          "description": "How far under the reference level a turn may be, dB.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "window_s": {
          "default": 45,
          "description": "How long the window stays open after Eileen's last turn, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "DesktopConfig": {
      "description": "Desktop control.",
      "properties": {
        "lease_idle_s": {
          "default": 5,
          "description": "A lease ends after this much idle time, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "visible_intent_ms": {
          "default": 400,
          "description": "How long the next click's target shows first, ms.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "web_tree": {
          "default": true,
          "description": "Read web pages' trees.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DictationConfig": {
      "description": "Dictation.",
      "properties": {
        "categories": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "description": "Whether to polish, per field category.",
          "type": "object"
        },
        "key": {
          "default": null,
          "description": "The dictation key; the `dictation` hotkey when unset.",
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "default": [],
          "description": "Languages to dictate in, as BCP 47 tags; the recognizer's own when empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "polish": {
          "default": true,
          "description": "Clean up fillers and self-corrections.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "DiffLine": {
      "description": "One line of a settings diff.",
      "properties": {
        "from": {
          "description": "The old value, as TOML; `None` when it was unset.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "The dotted key.",
          "type": "string"
        },
        "to": {
          "description": "The new value, as TOML.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "to"
      ],
      "type": "object"
    },
    "Distill": {
      "description": "Who distills skills.",
      "oneOf": [
        {
          "const": "claude",
          "description": "The librarian, on Claude.",
          "type": "string"
        },
        {
          "const": "off",
          "description": "Nobody.",
          "type": "string"
        }
      ]
    },
    "FirstRunConfig": {
      "description": "The first run.",
      "properties": {
        "done": {
          "default": false,
          "description": "Whether it has run.",
          "type": "boolean"
        },
        "max_clone_ttfa_ms": {
          "default": 3000,
          "description": "The clone's longest time to first audio, ms.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "FleetConfig": {
      "description": "The test fleet.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/FleetMode",
          "default": "recorded",
          "description": "Recorded (no model) or live."
        },
        "opt_in": {
          "default": false,
          "description": "The contributor opted in.",
          "type": "boolean"
        },
        "schedule": {
          "default": null,
          "description": "A nightly schedule, as `HH:MM` local time.",
          "type": [
            "string",
            "null"
          ]
        },
        "turn_budget": {
          "default": 0,
          "description": "Model turns a live run may spend.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "upload": {
          "default": false,
          "description": "Offer to upload results after a run.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "FlightConfig": {
      "description": "The flight recorder.",
      "properties": {
        "minutes": {
          "default": 10,
          "description": "How many minutes it keeps.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "FocusConfig": {
      "description": "When Eileen keeps quiet.",
      "properties": {
        "quiet_during_calls": {
          "default": true,
          "description": "During calls.",
          "type": "boolean"
        },
        "quiet_full_screen": {
          "default": true,
          "description": "While an app is full screen.",
          "type": "boolean"
        },
        "quiet_recording": {
          "default": true,
          "description": "While the screen is recorded.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "HotkeysConfig": {
      "description": "Hotkeys, as chords such as `ctrl+alt+m`; `None` is unbound.",
      "properties": {
        "approve": {
          "default": null,
          "description": "Approve the pending question.",
          "type": [
            "string",
            "null"
          ]
        },
        "deny": {
          "default": null,
          "description": "Deny the pending question.",
          "type": [
            "string",
            "null"
          ]
        },
        "dictation": {
          "default": null,
          "description": "Hold to dictate.",
          "type": [
            "string",
            "null"
          ]
        },
        "hands_off": {
          "default": null,
          "description": "Hands off: stop every desktop job.",
          "type": [
            "string",
            "null"
          ]
        },
        "mute": {
          "default": "ctrl+alt+m",
          "description": "Mute and unmute.",
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "default": "ctrl+alt+shift+b",
          "description": "Save an incident report.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "HudConfig": {
      "description": "The HUD.",
      "properties": {
        "corner": {
          "$ref": "#/$defs/Corner",
          "default": "bottom_right",
          "description": "The screen corner."
        },
        "opacity_pct": {
          "default": 90,
          "description": "Opacity, percent.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "scale_pct": {
          "default": 100,
          "description": "Scale, percent.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "show_transcript": {
          "default": true,
          "description": "Show what was heard.",
          "type": "boolean"
        },
        "suggestions": {
          "default": true,
          "description": "Show suggestions.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Humor": {
      "description": "How playful the assistant is.",
      "oneOf": [
        {
          "const": "off",
          "description": "None.",
          "type": "string"
        },
        {
          "const": "light",
          "description": "A little.",
          "type": "string"
        },
        {
          "const": "playful",
          "description": "Playful.",
          "type": "string"
        }
      ]
    },
    "IncidentsConfig": {
