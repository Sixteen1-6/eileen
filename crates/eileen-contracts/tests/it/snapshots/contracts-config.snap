    "Verbosity": {
      "description": "How much the assistant says.",
      "oneOf": [
        {
          "const": "brief",
          "description": "As little as works.",
          "type": "string"
        },
        {
          "const": "normal",
          "description": "A sentence or two.",
          "type": "string"
        },
        {
          "const": "detailed",
          "description": "Fuller answers.",
          "type": "string"
        }
      ]
    },
    "VoiceConfig": {
      "description": "Voices.",
      "properties": {
        "announcements": {
          "default": null,
          "description": "The voice for announcements; the live voice when unset.",
          "type": [
            "string",
            "null"
          ]
        },
        "engines": {
          "additionalProperties": {
            "$ref": "#/$defs/VoiceEngine"
          },
          "default": {},
          "description": "The engine per cloned voice name.",
          "type": "object"
        },
        "fallback": {
          "default": null,
          "description": "The voice to fall back to when a cloned voice cannot render in time.",
          "type": [
            "string",
            "null"
          ]
        },
        "live": {
          "default": null,
          "description": "The conversation's voice; `None` is the default voice in `models.toml`.",
          "type": [
            "string",
            "null"
          ]
        },
        "narration": {
          "default": null,
          "description": "The voice for narration; the live voice when unset.",
          "type": [
            "string",
            "null"
          ]
        },
        "rate_pct": {
          "default": 100,
          "description": "Speaking rate, percent.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "watermark_exports": {
          "default": false,
          "description": "Mark saved and exported audio (`eileen voice render` files and the audio lanes of\nrecordings) with the `AudioSeal` watermark. Opt in: no engine watermarks by default, and\nturning this on is what makes `eileen setup` fetch the `AudioSeal` models.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "VoiceEngine": {
      "description": "The engines a cloned voice can render with.",
      "oneOf": [
        {
          "const": "pocket",
          "description": "Pocket TTS.",
          "type": "string"
        },
        {
          "const": "chatterbox-turbo",
          "description": "Chatterbox Turbo.",
          "type": "string"
        },
        {
          "const": "chatterbox-nano",
          "description": "Chatterbox Nano.",
          "type": "string"
        }
      ]
    }
  }
}
