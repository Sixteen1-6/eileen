            "$ref": "#/$defs/DiffLine"
          },
          "type": "array"
        },
        "snapshot_toml": {
          "description": "The whole file after the change.",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/SettingsSource",
          "description": "Where the change came from."
        },
        "utterance": {
          "description": "What the user said.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "The version number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
