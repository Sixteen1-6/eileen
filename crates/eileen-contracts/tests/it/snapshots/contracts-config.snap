    },
    "LearningConfig": {
      "description": "The learning loop.",
      "properties": {
        "distill": {
          "$ref": "#/$defs/Distill",
          "default": "claude",
          "description": "Who distills skills."
        },
        "enabled": {
          "default": true,
          "description": "Whether it is on.",
          "type": "boolean"
        },
        "ladder": {
          "$ref": "#/$defs/LadderPolicy",
          "default": {
            "archive_idle_days": 30,
            "demote_failures_in_last5": 2,
            "light": {
              "l2_distinct_slot_values": 1,
              "l2_successes": 1,
              "l3_agreeing_shadows": 1,
              "l4_clean_pct_last_20": 0,
              "l4_clean_replays": 3
            },
            "standard": {
              "l2_distinct_slot_values": 2,
              "l2_successes": 3,
              "l3_agreeing_shadows": 3,
              "l4_clean_pct_last_20": 95,
              "l4_clean_replays": 10
            }
          },
          "description": "The promotion ladder."
        },
        "librarian_max_plan_pct": {
          "default": 50,
          "description": "The librarian runs only below this plan usage, percent.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "phrasing_min_similarity": {
          "default": 0.85,
          "description": "The similarity a confirmed phrasing needs, 0 to 1 (0.85 until WP7 measures it).",
          "format": "double",
          "type": "number"
        },
        "phrasing_paraphrase_uses": {
          "default": 2,
          "description": "Uses before a paraphrase becomes a phrasing.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "regret_window_s": {
          "default": 120,
          "description": "How long \"no\" or \"undo that\" counts against a job, seconds.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "snapshot_k": {
          "default": 12,
          "description": "Skills in a session's snapshot.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "LoggingConfig": {
      "description": "Logs.",
      "properties": {
        "keep_days": {
          "default": 14,
          "description": "How long log files are kept, days.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "default": "info",
          "description": "The filter, in `tracing`'s syntax.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpConfig": {
      "description": "Approved third-party MCP servers.",
      "properties": {
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServerConfig"
          },
          "default": {},
          "description": "Per app.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "McpServerConfig": {
      "description": "One approved server, installed once at its exact version in\n`%LOCALAPPDATA%\\eileen\\mcp\\<app>\\`. The tool names it lists go to `cache\\mcp-tools.json`,\nnot here.",
      "properties": {
        "args": {
          "default": [],
          "description": "Its arguments.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "description": "The command.",
          "type": "string"
        },
        "digest": {
          "description": "The install's lockfile or file digest.",
          "type": "string"
        },
        "job_kinds": {
          "description": "The job kinds that get it.",
          "items": {
            "$ref": "#/$defs/JobKind"
          },
          "type": "array"
        },
        "observes": {
          "$ref": "#/$defs/ObservedSource",
          "description": "What its results count as (web by default, section 2.12)."
        },
        "package_type": {
          "$ref": "#/$defs/PackageType",
          "description": "The package type."
        },
        "registry_id": {
          "description": "The registry's id for it.",
          "type": "string"
        },
        "rung": {
          "$ref": "#/$defs/Rung",
          "description": "Its rung: `app_mcp` or `dom`."
        },
        "version": {
          "description": "The exact version.",
          "type": "string"
        }
      },
      "required": [
        "registry_id",
        "package_type",
        "version",
        "command",
        "digest",
        "job_kinds",
        "rung",
        "observes"
      ],
      "type": "object"
    },
    "MemoryConfig": {
      "description": "Memory admission and the pools (section 2.5).",
      "properties": {
        "max_build_heavy_jobs": {
          "default": 1,
          "description": "Build-heavy jobs at once.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "max_paging_kb_s": {
          "$ref": "#/$defs/AutoOr_uint32",
          "default": "auto",
          "description": "The paging limit, KB/s; `auto` is the 75th percentile plus 25 percent of 7 days of\nmachine-wide 30 s averages outside build slots, clamped to 2,000 to 40,000; the build\nguard's baseline until a day exists; 5,000 when there is neither\n(`samples::auto_paging_limit`)."
        },
        "pool_computer_use": {
          "default": 1,
          "description": "Warm computer-use sessions.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "pool_deep": {
          "default": 1,
          "description": "Warm deep-answer sessions.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "pool_order": {
          "default": [
            "deep",
            "computer_use"
          ],
          "description": "Which pool fills first.",
          "items": {
            "$ref": "#/$defs/PoolClass"
          },
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/MemoryProfile",
          "default": "auto",
          "description": "The memory profile."
        },
        "queue_ask_min": {
          "default": 10,
          "description": "Ask before queueing for longer than this, minutes.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "reserve_mb": {
          "$ref": "#/$defs/AutoOr_uint32",
          "default": "auto",
          "description": "Memory kept free, MB; `auto` is 10 percent of RAM, 768 to 2048."
        },
        "worker_job_limit_mb": {
          "default": 0,
          "description": "A worker's Job Object memory limit, MB; 0 is off.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MemoryProfile": {
      "description": "The memory profile.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Chosen from the PC's memory.",
          "type": "string"
        },
        {
          "const": "full",
          "description": "Every model at full size.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "The low-memory models.",
          "type": "string"
        }
      ]
    },
    "PermissionsConfig": {
      "description": "Standing grants and app permissions.",
