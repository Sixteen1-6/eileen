            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PrivacyConfig": {
      "description": "Privacy.",
      "properties": {
        "keep_unaddressed": {
          "default": false,
          "description": "Keep unaddressed speech in persisted sinks.",
          "type": "boolean"
        },
        "ledger_days": {
          "default": 14,
          "description": "How long the ledger keeps lines, days.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "location": {
          "default": null,
          "description": "The user's location, as they said it, for \"near me\".",
          "type": [
            "string",
            "null"
          ]
        },
        "off_the_record": {
          "default": false,
          "description": "Off the record: nothing is learned or kept.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Proposal": {
      "description": "A proposed set of changes, checked and ready to confirm.",
      "properties": {
        "changes": {
          "description": "The changes.",
          "items": {
            "$ref": "#/$defs/SettingChange"
          },
          "type": "array"
        },
        "checks": {
          "description": "The checks and their results.",
          "items": {
            "$ref": "#/$defs/CheckResult"
          },
          "type": "array"
        },
        "confirm_sentence": {
          "description": "The sentence Eileen confirms with.",
          "type": "string"
        },
        "diff": {
          "description": "What would change, line by line.",
          "items": {
            "$ref": "#/$defs/DiffLine"
          },
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/ProposalId",
          "description": "Its id."
        },
        "needs_yes": {
          "description": "Whether it needs a yes.",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/SettingsSource",
          "description": "Where it came from."
        },
        "utterance": {
          "description": "What the user said.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "changes",
        "diff",
        "checks",
        "confirm_sentence",
        "needs_yes",
        "utterance",
        "source"
      ],
      "type": "object"
    },
    "RecordingConfig": {
      "description": "Recordings (retention, section 2.15).",
      "properties": {
        "audio": {
          "default": false,
          "description": "Record the audio lanes too (opt in).",
          "type": "boolean"
        },
        "keep_days": {
          "default": 7,
          "description": "How long they are kept, days.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "max_mb": {
          "default": 2048,
          "description": "Their total size cap, MB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "RecycleThresholds": {
      "description": "When the brain's session is recycled (section 2.3).",
      "properties": {
        "context_tokens": {
          "default": 60000,
          "description": "The context size reported in the `result` usage, tokens.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Risk": {
      "description": "A setting's risk.",
      "oneOf": [
        {
          "const": "low",
          "description": "Harmless.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A change could misfire; this check runs first.",
          "properties": {
            "misfire": {
              "$ref": "#/$defs/CheckKind"
            }
          },
          "required": [
            "misfire"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A safety key, within this bound (section 2.11).",
          "properties": {
            "safety": {
              "$ref": "#/$defs/SafetyBound"
            }
          },
          "required": [
            "safety"
          ],
          "type": "object"
        }
      ]
    },
    "RoutingConfig": {
      "description": "Models, backends and routes.",
      "properties": {
        "brain": {
          "$ref": "#/$defs/BackendChoice",
          "default": {
            "backend": "claude",
            "model": "fast"
          },
          "description": "The brain."
        },
        "deep": {
          "$ref": "#/$defs/BackendChoice",
          "default": {
            "backend": "claude",
            "model": "strong"
          },
          "description": "Deep answers."
        },
        "fallback_brain": {
          "$ref": "#/$defs/BackendChoice",
          "default": {
            "backend": "claude",
            "model": "fast"
          },
          "description": "The brain's fallback slot."
        },
        "hot_spare": {
          "default": true,
          "description": "Keep a warm spare brain.",
          "type": "boolean"
        },
        "kinds": {
          "additionalProperties": {
            "$ref": "#/$defs/KindRouting"
          },
          "default": {},
          "description": "Per job kind.",
          "type": "object"
        },
        "models": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "fast": "haiku",
            "mid": "sonnet",
            "strong": "opus"
          },
          "description": "Model names to vendor aliases or full ids.",
          "type": "object"
        },
        "recycle": {
          "$ref": "#/$defs/RecycleThresholds",
          "default": {
            "context_tokens": 60000
          },
          "description": "When the brain's session is recycled."
        },
        "speculative": {
          "default": false,
          "description": "Start the brain on a partial transcript.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "SafetyBound": {
      "description": "How far a safety key may be changed.",
      "oneOf": [
        {
          "const": "needs_user_approval",
          "description": "Only with an approval from `UserInput`.",
          "type": "string"
        },
        {
          "const": "tier1_only",
          "description": "Only to tier 1.",
          "type": "string"
        },
        {
          "const": "tier2_with_logged_decision",
          "description": "To tier 2 only with a logged decision.",
          "type": "string"
        },
        {
          "const": "never",
          "description": "Never by voice or by a model.",
          "type": "string"
        }
      ]
    },
    "SettingChange": {
      "description": "One change to a setting.",
      "properties": {
        "key": {
          "description": "The dotted key.",
          "type": "string"
        },
        "value": {
          "description": "The new value."
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "SettingSpecView": {
      "description": "A setting as the core sees it: the serializable view of `eileen_config::SettingSpec`.",
      "properties": {
        "apply": {
          "$ref": "#/$defs/ApplyMode",
          "description": "When a change takes effect."
        },
        "doc": {
          "description": "Its documentation.",
          "type": "string"
        },
        "hud": {
          "description": "Whether it can be changed on the HUD.",
          "type": "boolean"
        },
        "key": {
          "description": "The dotted key, for example `assistant.name`.",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/Risk",
          "description": "Its risk."
        },
        "voice": {
          "description": "Whether it can be changed by voice.",
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "doc",
        "voice",
        "hud",
        "risk",
        "apply"
      ],
      "type": "object"
    },
    "SettingsCmd": {
      "description": "To the settings driver.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Run a proposal's checks.",
          "properties": {
            "run_checks": {
              "properties": {
                "proposal": {
                  "$ref": "#/$defs/Proposal",
                  "description": "The proposal."
                }
              },
              "required": [
                "proposal"
              ],
              "type": "object"
            }
          },
          "required": [
            "run_checks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Write a new version to the file and the history.",
          "properties": {
            "write_version": {
              "$ref": "#/$defs/SettingsVersion"
            }
          },
          "required": [
            "write_version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Apply these keys to the running components.",
          "properties": {
            "apply_live": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "apply_live"
          ],
          "type": "object"
        }
      ]
    },
    "SettingsEvent": {
      "description": "From the settings driver.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The config file changed on disk.",
          "properties": {
            "file_changed": {
              "properties": {
                "error_line": {
                  "description": "The first bad line.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "valid": {
                  "description": "Whether it is still valid.",
                  "type": "boolean"
                }
              },
              "required": [
                "valid"
              ],
              "type": "object"
            }
          },
          "required": [
            "file_changed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A proposal's checks finished.",
          "properties": {
            "checks_done": {
              "properties": {
                "checks": {
                  "description": "The results.",
                  "items": {
                    "$ref": "#/$defs/CheckResult"
                  },
                  "type": "array"
                },
                "proposal": {
                  "$ref": "#/$defs/ProposalId",
                  "description": "The proposal."
                }
              },
              "required": [
                "proposal",
                "checks"
              ],
              "type": "object"
            }
          },
          "required": [
            "checks_done"
          ],
          "type": "object"
        }
      ]
    },
    "SettingsSource": {
      "description": "Where a settings change came from.",
      "oneOf": [
        {
          "const": "voice",
          "description": "By voice.",
          "type": "string"
        },
        {
          "const": "hud",
          "description": "On the HUD.",
          "type": "string"
        },
        {
          "const": "file",
