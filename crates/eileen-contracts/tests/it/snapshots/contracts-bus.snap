---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "ApprovalSource": {
      "description": "Which form of the user's input resolved an approval; recorded in the approvals table and on\nthe bus.",
      "oneOf": [
        {
          "const": "hud_click",
          "description": "Physical, from the strip's Raw Input check.",
          "type": "string"
        },
        {
          "const": "hotkey",
          "description": "Physical, from the shell's Raw Input check.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The action word in the voice window.",
          "properties": {
            "voice": {
              "properties": {
                "action_word": {
                  "description": "The word heard.",
                  "type": "string"
                },
                "speaker_match": {
                  "description": "`None` when the speaker check is not enrolled.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "action_word"
              ],
              "type": "object"
            }
          },
          "required": [
            "voice"
          ],
          "type": "object"
        },
        {
          "const": "deadline",
          "description": "Declined when `approvals.deadline_min` passed.",
          "type": "string"
        },
        {
          "const": "job_ended",
          "description": "The job was cancelled or failed while the question was open.",
          "type": "string"
        }
      ]
    },
    "BusEvent": {
      "description": "What happened, for everyone listening.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A turn began.",
          "properties": {
            "turn_started": {
              "properties": {
                "authority": {
                  "$ref": "#/$defs/TurnAuthority",
                  "description": "Whether it may use the full brain tools."
                },
                "source": {
                  "$ref": "#/$defs/TurnSource",
                  "description": "Where it came from."
                }
              },
              "required": [
                "source",
                "authority"
              ],
              "type": "object"
            }
          },
          "required": [
            "turn_started"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The final transcript, only once the turn is not ignored.",
          "properties": {
            "heard": {
              "properties": {
                "text": {
                  "description": "The transcript.",
                  "type": "string",
                  "x-eileen-text": "personal"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "heard"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Where the turn went.",
          "properties": {
            "turn_routed": {
              "properties": {
                "reason": {
                  "description": "Why, in a few words.",
                  "type": "string"
                },
                "route": {
                  "$ref": "#/$defs/TurnRoute",
                  "description": "The route."
                }
              },
              "required": [
                "route",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "turn_routed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Eileen started speaking.",
          "properties": {
            "speaking": {
              "properties": {
                "cause": {
                  "$ref": "#/$defs/SpeakCause",
                  "description": "Why she speaks."
                },
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                },
                "text": {
                  "description": "What she says.",
                  "type": "string"
                }
              },
              "required": [
                "speak",
                "cause",
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "speaking"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Eileen stopped speaking.",
          "properties": {
            "speaking_stopped": {
              "properties": {
                "heard_chars": {
                  "description": "Characters the user heard.",
