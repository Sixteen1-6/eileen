              "type": "object"
            }
          },
          "required": [
            "doctor"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Change a setting, through the normal settings flow.",
          "properties": {
            "setting": {
              "properties": {
                "change": {
                  "$ref": "#/$defs/SettingChange",
