          "type": "string"
        },
        {
          "const": "reveal",
          "description": "The surprise path: the reveal.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Skipped.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished.",
          "type": "string"
        }
      ]
    },
    "FixAction": {
      "description": "A fix the user can run from an error.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Open a URI (a settings page, a help page).",
          "properties": {
            "open_uri": {
              "properties": {
                "uri": {
                  "description": "The URI.",
                  "type": "string"
                }
              },
              "required": [
                "uri"
              ],
              "type": "object"
            }
          },
          "required": [
            "open_uri"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Run a doctor check.",
          "properties": {
            "doctor": {
              "properties": {
                "area": {
                  "description": "The area, for example `claude` or `resolve`.",
                  "type": "string"
                }
