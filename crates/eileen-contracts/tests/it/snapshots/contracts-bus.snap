                  "minimum": 0,
                  "type": "integer"
                },
                "interrupted": {
                  "description": "Whether the user interrupted.",
                  "type": "boolean"
                },
                "resumed": {
                  "description": "Whether she resumed after a backchannel.",
                  "type": "boolean"
                },
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
