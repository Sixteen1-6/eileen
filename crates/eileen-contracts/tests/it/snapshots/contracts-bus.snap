          },
          "required": [
            "setting"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Retry a job.",
          "properties": {
            "retry": {
              "properties": {
                "job": {
                  "$ref": "#/$defs/JobId",
                  "description": "The job."
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "retry"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explain an incident.",
          "properties": {
            "explain": {
              "properties": {
                "incident": {
                  "$ref": "#/$defs/IncidentId",
                  "description": "The incident."
                }
              },
              "required": [
                "incident"
              ],
              "type": "object"
            }
          },
          "required": [
            "explain"
          ],
          "type": "object"
        }
      ]
    },
