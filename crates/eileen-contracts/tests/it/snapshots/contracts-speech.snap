                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "clause": {
                  "description": "The clause.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
