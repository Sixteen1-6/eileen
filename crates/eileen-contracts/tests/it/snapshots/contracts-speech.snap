        },
        {
          "additionalProperties": false,
          "description": "An embedding the core asked for.",
          "properties": {
            "embedding": {
              "properties": {
                "request": {
                  "description": "The request.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "vector": {
                  "description": "The vector.",
                  "items": {
                    "format": "float",
                    "type": "number"
                  },
                  "type": "array"
