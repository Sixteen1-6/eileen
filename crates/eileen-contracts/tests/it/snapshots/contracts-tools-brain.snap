      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_state`. Tier 0.",
      "properties": {
        "detail": {
          "$ref": "#/$defs/Detail",
          "description": "How much to return."
        },
        "since_seq": {
          "description": "Only changes after this sequence number.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "detail"
      ],
      "title": "DesktopStateArgs",
      "type": "object"
    },
    "hud_show": {
