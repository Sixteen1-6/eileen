        },
        "TurnId": {
          "description": "A ULID with the prefix `turn_`, upper-case Crockford base32",
          "pattern": "^turn_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`scenario_save`. Tier 1.",
      "properties": {
        "expected": {
          "description": "What should have happened.",
          "type": [
            "string",
            "null"
          ]
        },
        "failed": {
          "default": false,
          "description": "Save it as a failure.",
          "type": "boolean"
        },
        "which": {
          "$ref": "#/$defs/SaveTarget",
          "description": "What to save."
        }
      },
      "required": [
        "which"
      ],
      "title": "ScenarioSave",
      "type": "object"
    },
    "settings_apply": {
      "$defs": {
        "ProposalId": {
          "description": "A ULID with the prefix `prop_`, upper-case Crockford base32",
          "pattern": "^prop_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`settings_apply`. The tier follows the proposal's risk; `Safety` keys need a `UserInput`\napproval.",
      "properties": {
        "proposal": {
          "$ref": "#/$defs/ProposalId",
          "description": "The proposal."
        }
      },
      "required": [
        "proposal"
      ],
      "title": "SettingsApply",
      "type": "object"
    },
    "settings_get": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`settings_get`. Tier 0.",
      "properties": {
        "keys": {
          "default": [],
          "description": "The keys; empty for a short summary.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "SettingsGet",
      "type": "object"
    },
    "settings_propose": {
      "$defs": {
        "SettingChange": {
          "description": "One change to a setting.",
          "properties": {
            "key": {
              "description": "The dotted key.",
              "type": "string"
            },
            "value": {
              "description": "The new value."
            }
          },
          "required": [
            "key",
            "value"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`settings_propose`: returns a `Proposal`. Tier 0.",
      "properties": {
        "changes": {
          "description": "The changes.",
          "items": {
            "$ref": "#/$defs/SettingChange"
          },
          "type": "array"
        },
        "utterance": {
          "description": "What the user said.",
          "type": "string"
        }
      },
      "required": [
        "changes",
        "utterance"
      ],
      "title": "SettingsPropose",
      "type": "object"
    },
    "settings_undo": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`settings_undo`. Tier 1.",
      "properties": {
        "steps": {
          "description": "How many versions back.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "to_version": {
          "description": "Or straight to this version.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "SettingsUndo",
      "type": "object"
    }
  }
}
