      "$defs": {
        "JobId": {
          "description": "A ULID with the prefix `job_`, upper-case Crockford base32",
          "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        "SaveTarget": {
          "description": "What `scenario_save` saves.",
          "oneOf": [
            {
              "const": "last",
              "description": "The last request.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "One turn.",
              "properties": {
