    "jobs_control": {
      "$defs": {
        "Depth": {
          "description": "How much thought a request gets.",
          "oneOf": [
            {
              "const": "instant",
              "description": "Answered at once, by the fast path or the brain's first words.",
              "type": "string"
            },
            {
              "const": "quick",
              "description": "A short job.",
              "type": "string"
            },
            {
              "const": "considered",
              "description": "A job given room to think.",
              "type": "string"
            },
            {
              "const": "deep",
              "description": "The deepest model and the most time.",
              "type": "string"
            }
          ]
        },
        "JobAction": {
          "description": "What `jobs_control` does.",
          "oneOf": [
            {
              "const": "cancel",
              "description": "Stop it.",
              "type": "string"
            },
            {
              "const": "interrupt",
              "description": "Interrupt its current turn.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Interrupt it and give it new words.",
              "properties": {
                "steer": {
                  "properties": {
                    "text": {
                      "description": "The words.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "steer"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Move it to another route, model or depth.",
              "properties": {
                "reroute": {
                  "properties": {
                    "depth": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/Depth"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The depth."
                    },
                    "model": {
                      "description": "The model.",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "route": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/Route"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The route."
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "reroute"
              ],
              "type": "object"
            },
            {
              "const": "focus",
              "description": "Focus on it.",
              "type": "string"
            },
            {
              "const": "show_changes",
              "description": "Show its changes.",
              "type": "string"
            },
            {
              "const": "keep",
              "description": "Keep its changes.",
              "type": "string"
            },
            {
              "const": "undo",
              "description": "Undo its changes.",
              "type": "string"
            }
          ]
        },
        "JobId": {
          "description": "A ULID with the prefix `job_`, upper-case Crockford base32",
          "pattern": "^job_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        "JobRef": {
          "description": "How a tool names a job.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "By id.",
              "properties": {
                "id": {
                  "$ref": "#/$defs/JobId"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "By slug.",
              "properties": {
                "slug": {
                  "type": "string"
                }
              },
              "required": [
                "slug"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "By spoken name.",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "\"the second one\".",
              "properties": {
                "ordinal": {
                  "format": "uint8",
                  "maximum": 255,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "ordinal"
              ],
              "type": "object"
            }
          ]
        },
        "Route": {
          "description": "A route: which vendor harness or model family does a piece of work. Workers are named only\nby route.",
          "oneOf": [
            {
              "const": "claude",
              "description": "Claude, through the user's own signed-in `claude` CLI. The only route built in v0.1.",
              "type": "string"
            },
            {
              "const": "codex",
              "description": "The Codex app server (a designed slot).",
              "type": "string"
            },
            {
              "const": "grok",
              "description": "Grok over ACP (a designed slot).",
              "type": "string"
            },
            {
              "const": "deepseek",
              "description": "`DeepSeek` (a designed slot; its API key is the one key Eileen would store).",
              "type": "string"
            },
            {
              "const": "local",
              "description": "A local model (a designed slot).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`jobs_control`. Tier 1; `Keep` with cleanup tier 2.",
      "properties": {
        "action": {
          "$ref": "#/$defs/JobAction",
          "description": "What to do."
        },
        "job": {
          "$ref": "#/$defs/JobRef",
          "description": "The job."
        }
      },
      "required": [
        "job",
        "action"
      ],
      "title": "JobsControl",
      "type": "object"
    },
    "jobs_dispatch": {
      "$defs": {
        "Depth": {
          "description": "How much thought a request gets.",
          "oneOf": [
            {
              "const": "instant",
              "description": "Answered at once, by the fast path or the brain's first words.",
              "type": "string"
            },
            {
              "const": "quick",
              "description": "A short job.",
              "type": "string"
            },
            {
              "const": "considered",
              "description": "A job given room to think.",
              "type": "string"
            },
            {
              "const": "deep",
              "description": "The deepest model and the most time.",
              "type": "string"
            }
          ]
        },
        "FanoutMode": {
          "description": "How a fan-out's workers share a task.",
          "oneOf": [
            {
              "const": "compete",
              "description": "Every worker tries the whole task; the best result wins.",
              "type": "string"
            },
            {
              "const": "split",
              "description": "Each worker takes one subtask.",
              "type": "string"
            }
          ]
        },
        "JobKind": {
          "description": "What kind of work a job is.",
          "oneOf": [
            {
              "const": "coding",
              "description": "Code changes in a repository worktree.",
              "type": "string"
            },
            {
              "const": "computer_use",
              "description": "Driving the desktop through Eileen's desktop and apps tools.",
              "type": "string"
            },
            {
              "const": "general",
              "description": "A general task with the desktop and apps toolsets.",
              "type": "string"
            },
            {
              "const": "research",
              "description": "Research on the web.",
              "type": "string"
            },
            {
              "const": "deep_answer",
              "description": "A deep answer to a question, in the background of a fast one.",
              "type": "string"
            },
            {
              "const": "librarian",
              "description": "The learning loop's librarian.",
              "type": "string"
            },
            {
              "const": "replay",
              "description": "A learned recipe replayed without a model.",
              "type": "string"
            },
            {
              "const": "continue_session",
              "description": "Continuing an earlier Claude session.",
              "type": "string"
            },
            {
              "const": "app_task",
              "description": "A task inside one app through its adapter.",
              "type": "string"
            },
            {
              "const": "act",
              "description": "A fast-path command or a brain turn that ran `act` tools: no session, silent, ends with\nits turn.",
              "type": "string"
            },
            {
              "const": "ml_project",
              "description": "Reserved for the v0.2 Colab connector; refused in v0.1.",
              "type": "string"
            }
          ]
        },
        "Route": {
          "description": "A route: which vendor harness or model family does a piece of work. Workers are named only\nby route.",
          "oneOf": [
            {
              "const": "claude",
              "description": "Claude, through the user's own signed-in `claude` CLI. The only route built in v0.1.",
              "type": "string"
            },
            {
              "const": "codex",
              "description": "The Codex app server (a designed slot).",
              "type": "string"
            },
            {
              "const": "grok",
              "description": "Grok over ACP (a designed slot).",
              "type": "string"
            },
            {
              "const": "deepseek",
              "description": "`DeepSeek` (a designed slot; its API key is the one key Eileen would store).",
              "type": "string"
            },
            {
              "const": "local",
              "description": "A local model (a designed slot).",
              "type": "string"
            }
          ]
        },
        "SkillId": {
          "description": "1 to 64 lower-case letters, digits and hyphens",
          "pattern": "^[a-z0-9-]{1,64}$",
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`jobs_dispatch`: start one job, or a fan-out. Tier 1 (asks first when plan usage is high and\n`fanout` is above 2).",
      "properties": {
        "anticipated": {
          "default": false,
          "description": "`DeepAnswer` only: started by anticipation.",
          "type": "boolean"
        },
        "depth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Depth"
            },
            {
              "type": "null"
            }
          ],
          "description": "How much thought it gets."
        },
        "fanout": {
          "description": "How many workers, 1 to 8.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/JobKind",
          "description": "The kind of job."
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/FanoutMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the workers share the task."
        },
        "model": {
          "description": "A model name from `routing.models`, or a full id.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "A repository name or absolute path.",
          "type": [
            "string",
            "null"
          ],
          "x-eileen-path": true
        },
        "route": {
          "anyOf": [
            {
              "$ref": "#/$defs/Route"
            },
            {
              "type": "null"
            }
          ],
          "description": "The route; leave it out to let policy decide."
        },
        "skill": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkillId"
            },
            {
              "type": "null"
            }
          ],
          "description": "A learned skill to follow."
        },
        "slots": {
          "description": "Kind `Replay`: must equal the `[match]` block's skill and slots; any other kind with a\nskill: the slots the use is attributed with, validated against the skill's slot specs."
        },
        "subquestions": {
          "default": [],
          "description": "`DeepAnswer`: at most 4 subquestions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subtasks": {
          "default": [],
          "description": "`Split` mode: one subtask per worker.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "description": "The task, up to 8,000 characters.",
          "type": "string"
        },
        "title_hint": {
          "description": "A hint for the job's spoken name.",
          "type": [
            "string",
            "null"
          ]
        },
        "topic": {
          "description": "`DeepAnswer` only: a short topic key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "task"
      ],
      "title": "JobsDispatch",
      "type": "object"
    },
