    "apps_open_path": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`apps_open_path`, by arguments (section 2.7): 1 for a document or folder; 2, HUD only, when\nit runs code or `with_app` is a shell or interpreter; 3 for a credential, Eileen-data or\nbrowser-profile path.",
      "properties": {
