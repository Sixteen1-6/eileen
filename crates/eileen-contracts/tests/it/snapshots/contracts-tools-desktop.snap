          "type": "boolean"
        },
        "name": {
          "description": "The app, as the user said it.",
          "type": "string"
        },
        "wait_main_window_ms": {
          "description": "Wait for its main window, ms.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "title": "DesktopLaunchApp",
      "type": "object"
    },
    "desktop_press_keys": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
