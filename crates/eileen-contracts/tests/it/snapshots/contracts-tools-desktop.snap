      "required": [
        "hwnd",
        "x",
        "y",
        "dx",
        "dy"
      ],
      "title": "DesktopScroll",
      "type": "object"
    },
    "desktop_selection": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_selection`. Tier 0.",
      "properties": {
        "allow_clipboard": {
          "default": false,
          "description": "Fall back to the clipboard.",
          "type": "boolean"
        },
        "hwnd": {
          "description": "The window; the foreground one when left out.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "title": "DesktopSelection",
      "type": "object"
    },
    "desktop_set_value": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_set_value`. Tier 1; refuses password fields.",
      "properties": {
        "element": {
          "description": "The element's index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "hwnd": {
          "description": "The window.",
          "format": "int64",
          "type": "integer"
        },
        "value": {
          "description": "The value.",
          "type": "string"
        }
      },
      "required": [
        "hwnd",
        "element",
        "value"
      ],
      "title": "DesktopSetValue",
      "type": "object"
    },
    "desktop_tree": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_tree`: a window's UI Automation tree. Tier 0.",
      "properties": {
        "hwnd": {
          "description": "The window.",
          "format": "int64",
          "type": "integer"
        },
        "max_depth": {
          "description": "How deep, 12 by default.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_elements": {
          "description": "How many elements, 250 by default.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "query": {
          "description": "Only elements matching this text.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "hwnd"
      ],
      "title": "DesktopTree",
      "type": "object"
    },
    "desktop_type_text": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_type_text`. Tier 1 (2 in terminals and unknown targets); takes the foreground.",
      "properties": {
        "element": {
          "description": "The element to focus first.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "hwnd": {
          "description": "The window.",
          "format": "int64",
          "type": "integer"
        },
        "text": {
          "description": "The text.",
          "type": "string"
        }
      },
      "required": [
        "hwnd",
        "text"
      ],
      "title": "DesktopTypeText",
      "type": "object"
    },
    "desktop_volume": {
      "$defs": {
        "VolumeAction": {
          "description": "What `desktop_volume` does.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "Set the volume.",
              "properties": {
                "set": {
                  "properties": {
                    "pct": {
                      "description": "Percent.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "pct"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "set"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Change the volume.",
              "properties": {
                "step": {
                  "properties": {
                    "delta_pct": {
                      "description": "Percentage points, up or down.",
                      "format": "int8",
                      "maximum": 127,
                      "minimum": -128,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "delta_pct"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "step"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Mute or unmute.",
              "properties": {
                "mute": {
                  "type": "boolean"
                }
              },
              "required": [
                "mute"
              ],
              "type": "object"
            },
            {
              "const": "get",
              "description": "Read the volume.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_volume`, served through the `SystemVolume` platform trait. Tier 1 (`Get` 0); the\ninverse is journaled.",
      "properties": {
        "action": {
          "$ref": "#/$defs/VolumeAction",
          "description": "What to do."
        }
      },
      "required": [
        "action"
      ],
      "title": "DesktopVolume",
      "type": "object"
    },
    "desktop_wait_for": {
      "$defs": {
        "Selector": {
          "additionalProperties": false,
          "description": "How an element is found again: by its process, window and its own identity. Unknown fields\nare refused, so a misspelt field never widens the match.",
          "properties": {
            "ancestors": {
              "default": [],
              "description": "Its ancestors, nearest first.",
              "items": {
                "$ref": "#/$defs/SelectorStep"
              },
              "type": "array"
            },
            "automation_id": {
              "description": "The element's automation id (a page sets it in a browser).",
              "type": [
                "string",
                "null"
              ],
              "x-eileen-text": "untrusted"
            },
            "control_type": {
              "description": "The element's control type.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "The element's name.",
              "type": [
                "string",
                "null"
              ],
              "x-eileen-text": "untrusted"
            },
            "process": {
              "description": "The process name.",
              "type": "string"
            },
            "window_class": {
              "description": "The window class.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "process"
          ],
          "type": "object"
        },
        "SelectorStep": {
          "additionalProperties": false,
          "description": "One ancestor of a selected element.",
          "properties": {
            "automation_id": {
              "description": "Its automation id (a page sets it in a browser).",
              "type": [
                "string",
                "null"
              ],
              "x-eileen-text": "untrusted"
            },
            "control_type": {
              "description": "Its control type.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Its name.",
              "type": [
                "string",
                "null"
              ],
              "x-eileen-text": "untrusted"
            }
          },
          "type": "object"
        },
        "WaitCondition": {
          "description": "What `desktop_wait_for` waits for.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "A window of this process opens.",
              "properties": {
                "window_open": {
                  "properties": {
                    "process": {
                      "description": "The process name.",
                      "type": "string"
                    },
                    "title_contains": {
                      "description": "Text its title contains.",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "process"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "window_open"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A window closes.",
              "properties": {
                "window_closed": {
                  "properties": {
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "hwnd"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "window_closed"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "An element appears.",
              "properties": {
                "element": {
                  "properties": {
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    },
                    "selector": {
                      "$ref": "#/$defs/Selector",
                      "description": "The element."
                    }
                  },
                  "required": [
                    "hwnd",
                    "selector"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "element"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A window becomes the foreground window.",
              "properties": {
                "foreground": {
                  "properties": {
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "hwnd"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "foreground"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_wait_for`: at most 30,000 ms. Tier 0.",
      "properties": {
        "condition": {
          "$ref": "#/$defs/WaitCondition",
          "description": "What to wait for."
        },
        "timeout_ms": {
          "description": "How long, ms.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "condition",
        "timeout_ms"
      ],
      "title": "DesktopWaitFor",
      "type": "object"
    },
    "desktop_window": {
      "$defs": {
        "Rect": {
          "description": "A rectangle in physical virtual-screen pixels.",
          "properties": {
            "h": {
              "description": "Height.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "w": {
              "description": "Width.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "description": "Left edge.",
              "format": "int32",
              "type": "integer"
            },
            "y": {
              "description": "Top edge.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        "ShowReason": {
          "description": "Why a window is brought forward.",
          "oneOf": [
            {
              "const": "approval",
              "description": "The user must approve something in it.",
              "type": "string"
            },
            {
              "const": "result",
              "description": "It shows a job's result.",
              "type": "string"
            },
            {
              "const": "question",
              "description": "It asks the user something only the app can ask.",
              "type": "string"
            }
          ]
        },
        "SnapZone": {
          "description": "Where a window snaps.",
          "oneOf": [
            {
              "const": "left",
              "description": "The left part.",
              "type": "string"
            },
            {
              "const": "right",
              "description": "The right part.",
              "type": "string"
            },
            {
              "const": "top",
              "description": "The top part.",
              "type": "string"
            },
            {
              "const": "bottom",
              "description": "The bottom part.",
              "type": "string"
            },
            {
              "const": "top_left",
              "description": "The top-left quarter.",
              "type": "string"
            },
            {
              "const": "top_right",
              "description": "The top-right quarter.",
              "type": "string"
            },
            {
              "const": "bottom_left",
              "description": "The bottom-left quarter.",
              "type": "string"
            },
            {
              "const": "bottom_right",
              "description": "The bottom-right quarter.",
              "type": "string"
            },
            {
              "const": "center",
              "description": "Centred.",
              "type": "string"
            }
          ]
        },
        "WindowAction": {
          "description": "What `desktop_window` does.",
          "oneOf": [
            {
              "const": "focus",
              "description": "Bring it to the front.",
              "type": "string"
            },
            {
              "const": "minimize",
              "description": "Minimize it.",
              "type": "string"
            },
            {
              "const": "maximize",
              "description": "Maximize it.",
              "type": "string"
            },
            {
              "const": "restore",
              "description": "Restore it.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Move and size it.",
              "properties": {
                "move": {
                  "properties": {
                    "rect": {
                      "$ref": "#/$defs/Rect",
                      "description": "Its new frame."
                    }
                  },
                  "required": [
                    "rect"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "move"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "Snap it to part of a monitor.",
              "properties": {
                "snap": {
                  "properties": {
                    "fraction_pct": {
                      "description": "How much of the monitor, percent.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "monitor": {
                      "description": "The monitor's ordinal; the window's own when left out.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "zone": {
                      "$ref": "#/$defs/SnapZone",
                      "description": "The zone."
                    }
                  },
                  "required": [
                    "zone"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "snap"
              ],
              "type": "object"
            },
            {
              "const": "close",
              "description": "Close it (`WM_CLOSE` through `SendMessageTimeout`).",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "Bring it forward because the user should look (section 2.6).",
              "properties": {
                "show": {
                  "properties": {
                    "reason": {
                      "$ref": "#/$defs/ShowReason",
                      "description": "Why."
                    }
                  },
                  "required": [
                    "reason"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "show"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_window`. Tier 1; `Close` is tier 1 when the app reports nothing unsaved, else 2.",
      "properties": {
        "action": {
          "$ref": "#/$defs/WindowAction",
          "description": "What to do."
        },
        "hwnd": {
          "description": "The window.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "hwnd",
        "action"
      ],
      "title": "DesktopWindow",
      "type": "object"
    },
    "desktop_windows": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_windows`. Tier 0.",
      "properties": {
        "include_minimized": {
          "default": false,
          "description": "Include minimized windows.",
          "type": "boolean"
        }
      },
      "title": "DesktopWindows",
      "type": "object"
    }
  }
}
