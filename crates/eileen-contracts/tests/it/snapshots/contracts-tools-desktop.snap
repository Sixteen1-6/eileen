        "from",
        "to",
        "button"
      ],
      "title": "DesktopDrag",
      "type": "object"
    },
    "desktop_insert_text": {
      "$defs": {
        "FieldCategory": {
          "description": "What kind of field text goes into, for dictation and insertion.",
          "oneOf": [
            {
              "const": "plain",
              "description": "Plain text.",
              "type": "string"
            },
            {
              "const": "email",
              "description": "An e-mail.",
              "type": "string"
            },
            {
              "const": "chat",
              "description": "A chat message.",
              "type": "string"
            },
            {
              "const": "document",
              "description": "A document.",
              "type": "string"
            },
            {
              "const": "code",
              "description": "Source code.",
              "type": "string"
            },
            {
              "const": "terminal",
              "description": "A terminal.",
              "type": "string"
            },
            {
              "const": "search",
              "description": "A search box.",
              "type": "string"
            },
            {
              "const": "form",
              "description": "A form field.",
              "type": "string"
            }
          ]
        },
        "InsertTarget": {
          "description": "Where inserted text goes.",
          "oneOf": [
            {
              "const": "focused",
              "description": "The focused element.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "An element of a window.",
              "properties": {
                "element": {
                  "properties": {
                    "element": {
                      "description": "The element's index.",
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    },
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "hwnd",
                    "element"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "element"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A window's focused element.",
              "properties": {
                "window": {
                  "properties": {
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "hwnd"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "window"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_insert_text`: the insertion ladder. Tier 1.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldCategory"
            },
            {
              "type": "null"
            }
          ],
          "description": "What kind of field it is."
        },
        "target": {
          "$ref": "#/$defs/InsertTarget",
          "description": "Where it goes."
        },
        "text": {
          "description": "The text.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "target"
      ],
      "title": "DesktopInsertText",
      "type": "object"
    },
    "desktop_launch_app": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_launch_app`. Tier 1; an ambiguous name returns candidates.",
      "properties": {
        "dry_run": {
          "default": false,
