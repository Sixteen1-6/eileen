        }
      },
      "required": [
        "hwnd",
        "keys"
      ],
      "title": "DesktopPressKeys",
      "type": "object"
    },
    "desktop_screenshot": {
      "$defs": {
        "Rect": {
          "description": "A rectangle in physical virtual-screen pixels.",
          "properties": {
            "h": {
              "description": "Height.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "w": {
              "description": "Width.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "x": {
              "description": "Left edge.",
              "format": "int32",
              "type": "integer"
            },
            "y": {
              "description": "Top edge.",
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "type": "object"
        },
        "ShotTarget": {
          "description": "What a screenshot captures.",
          "oneOf": [
            {
              "const": "screen",
              "description": "Every monitor.",
              "type": "string"
            },
            {
              "additionalProperties": false,
              "description": "One monitor.",
              "properties": {
                "monitor": {
                  "properties": {
                    "ordinal": {
                      "description": "Its ordinal.",
                      "format": "uint8",
                      "maximum": 255,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "ordinal"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "monitor"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "One window.",
              "properties": {
                "window": {
                  "properties": {
                    "hwnd": {
                      "description": "The window.",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "required": [
                    "hwnd"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "window"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A region.",
              "properties": {
                "region": {
                  "properties": {
                    "rect": {
                      "$ref": "#/$defs/Rect",
                      "description": "The region."
                    }
                  },
                  "required": [
                    "rect"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "region"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_screenshot`. Tier 0.",
      "properties": {
        "marks": {
          "default": false,
          "description": "Draw numbered marks on the elements.",
          "type": "boolean"
        },
        "max_edge_px": {
          "description": "The longest edge, pixels.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/ShotTarget",
          "description": "What to capture."
        }
      },
      "required": [
        "target"
      ],
      "title": "DesktopScreenshot",
      "type": "object"
    },
    "desktop_scroll": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "`desktop_scroll`. Tier 1.",
      "properties": {
        "dx": {
          "description": "Horizontal amount.",
          "format": "int32",
          "type": "integer"
        },
        "dy": {
          "description": "Vertical amount.",
          "format": "int32",
          "type": "integer"
        },
        "hwnd": {
          "description": "The window.",
          "format": "int64",
          "type": "integer"
        },
        "x": {
          "description": "Horizontal position.",
          "format": "int32",
          "type": "integer"
        },
        "y": {
          "description": "Vertical position.",
          "format": "int32",
