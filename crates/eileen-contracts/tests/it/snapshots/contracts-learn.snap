          "properties": {
            "pending_approval": {
              "properties": {
                "lines": {
                  "description": "The held lines.",
                  "items": {
                    "format": "uint32",
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": "array"
                }
              },
              "required": [
                "lines"
              ],
              "type": "object"
            }
          },
          "required": [
            "pending_approval"
          ],
          "type": "object"
        },
        {
          "const": "pending_review",
          "description": "The whole draft waits for review (free-text taint).",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Rejected by the linter.",
          "properties": {
            "rejected": {
              "properties": {
                "attempts_left": {
                  "description": "Tries left before the draft is dropped.",
