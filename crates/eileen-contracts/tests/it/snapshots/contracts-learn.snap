              "type": "object"
            }
          },
          "required": [
            "worker"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Eileen's schemas and descriptions.",
          "properties": {
            "tool": {
              "properties": {
                "tool": {
                  "$ref": "#/$defs/ToolName",
                  "description": "The tool."
                }
              },
              "required": [
                "tool"
              ],
              "type": "object"
            }
          },
          "required": [
            "tool"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Observed text, or a tainted step.",
          "properties": {
            "observed": {
              "properties": {
                "source": {
                  "$ref": "#/$defs/ObservedSource",
                  "description": "The source."
                }
              },
              "required": [
                "source"
              ],
              "type": "object"
            }
          },
          "required": [
            "observed"
          ],
          "type": "object"
        },
        {
          "const": "librarian",
          "description": "The librarian wrote it.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The user approved it.",
          "properties": {
            "approved": {
              "properties": {
                "approval": {
                  "$ref": "#/$defs/ApprovalId",
                  "description": "The approval."
                }
              },
              "required": [
                "approval"
              ],
              "type": "object"
            }
          },
          "required": [
            "approved"
          ],
          "type": "object"
        }
      ]
    },
    "Publisher": {
      "description": "A registry-verified publisher. `GitHub { user }` for `io.github.<user>` (verified by the\nregistry through that account); `Domain` for a reverse-DNS namespace (verified through DNS\nor HTTP); `display` is what the HUD shows and Eileen speaks.",
      "properties": {
        "display": {
          "description": "What is shown and spoken.",
          "type": "string"
        },
        "kind": {
