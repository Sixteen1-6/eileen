        "signals",
        "verdict",
        "objective_check"
      ],
      "type": "object"
    },
    "PackageType": {
      "description": "The package registries Eileen installs from.",
      "oneOf": [
        {
          "const": "npm",
          "description": "npm.",
          "type": "string"
        },
        {
          "const": "pypi",
          "description": "`PyPI`.",
          "type": "string"
        },
        {
          "const": "app_bundled",
          "description": "Shipped with the app.",
          "type": "string"
        }
      ]
    },
    "PhrasingFact": {
      "description": "A phrasing: how the user says something Eileen can do.",
      "properties": {
        "confirmed": {
          "description": "Times the user confirmed it.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "embedding": {
          "description": "The utterance's embedding.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "type": "array"
        },
        "ephemeral": {
          "description": "Made from a first-run demo turn: deleted when the first run ends.",
          "type": "boolean"
        },
        "id": {
          "description": "Its id.",
          "type": "string"
        },
        "provisional": {
          "description": "Exact repeats only, until the first clean regret window.",
          "type": "boolean"
        },
        "source_job": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The `Act` job it came from; forget plans use both."
        },
        "source_turn": {
          "$ref": "#/$defs/TurnId",
          "description": "The turn it came from."
        },
        "subject": {
          "description": "`SlotAlias` targets: the subject key of the phrase (\"video editor\"), from a clarifying\nanswer or \"X means Y\"; a `SameSubject` correction deletes the others.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "$ref": "#/$defs/PhrasingTarget",
          "description": "What it means."
        },
        "utterance": {
          "description": "What the user said.",
          "type": "string",
          "x-eileen-text": "personal"
        }
      },
      "required": [
        "id",
        "utterance",
        "target",
        "embedding",
        "confirmed",
        "provisional",
        "source_turn",
        "ephemeral"
      ],
      "type": "object"
    },
    "PhrasingTarget": {
      "description": "What a phrasing means.",
