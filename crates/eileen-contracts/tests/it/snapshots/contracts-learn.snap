    "ProposeOutcome": {
      "description": "What `learn_skill_propose` and a commit come to.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Committed.",
          "properties": {
            "committed": {
              "properties": {
                "version": {
                  "description": "The new version.",
