    },
    "RouteProposal": {
      "description": "A worker's proposal of a better route to an app. `app` is a key of Eileen's app index,\nvalidated by the dispatcher; `registry_id`, `McpPackage.version` and `Publisher.namespace`\nhave validated formats (a registry id, an exact semantic version, a reverse-DNS or\n`io.github.<user>` namespace). For `AppMcp` every other field but `why` comes from the\nregistry entry the proposal matched; `why` is the worker's note.",
      "properties": {
        "app": {
          "description": "The app.",
          "type": "string"
        },
        "from_app_vendor": {
          "description": "The namespace is a domain listed for this app in `app-vendors.toml`; there is no\n\"official\" flag (the registry's `_meta` block is bookkeeping).",
          "type": "boolean"
        },
        "id": {
          "$ref": "#/$defs/RouteProposalId",
          "description": "Its id."
        },
        "job": {
          "$ref": "#/$defs/JobId",
          "description": "The job that proposed it."
        },
        "kind": {
          "$ref": "#/$defs/RouteKind",
          "description": "The kind of route."
        },
        "name": {
          "description": "The server's name.",
          "type": "string",
          "x-eileen-text": "untrusted"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/McpPackage"
            },
            {
              "type": "null"
            }
          ],
          "description": "The package to install."
        },
        "publisher": {
          "anyOf": [
            {
              "$ref": "#/$defs/Publisher"
            },
            {
              "type": "null"
            }
          ],
          "description": "The registry-verified namespace of the server name, never a free-text field."
        },
        "registry_id": {
          "description": "The registry entry.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_url": {
          "description": "`AppMcp`: the registry entry's repository; `AppApi`: the worker's link.",
          "type": "string",
          "x-eileen-text": "untrusted"
        },
        "status": {
          "$ref": "#/$defs/ProposalStatus",
          "description": "Where it is."
        },
        "uri_scheme": {
          "description": "`DeepLink`: the URI scheme.",
          "type": [
            "string",
            "null"
          ],
          "x-eileen-text": "untrusted"
        },
        "verified": {
          "description": "`AppMcp` matched to a registry entry; `AppApi` and `DeepLink` are always false.",
          "type": "boolean"
        },
        "why": {
          "description": "The worker's note.",
          "type": "string",
          "x-eileen-text": "untrusted"
        }
      },
      "required": [
        "id",
        "app",
        "kind",
        "verified",
        "name",
        "from_app_vendor",
        "source_url",
        "why",
        "job",
        "status"
      ],
      "type": "object"
    },
