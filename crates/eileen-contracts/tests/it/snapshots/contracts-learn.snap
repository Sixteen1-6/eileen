---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "Check": {
      "description": "A check. Checks may only call ops that are read-only and tier 0; the linter enforces it\nagainst the connector manifests. With `tool` `None`, the check reads the step's own output.",
      "properties": {
        "args": {
          "description": "Its arguments."
        },
        "expect": {
          "$ref": "#/$defs/Expect",
          "description": "What the value must be."
        },
        "op": {
          "description": "The op's tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "A JSON pointer into the result.",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool to call, or `None` for the step's own output."
        }
      },
      "required": [
        "args",
        "path",
        "expect"
      ],
      "type": "object"
    },
    "CheckPlan": {
      "description": "A check the core must issue, with origin `Core`.",
      "properties": {
        "args": {
          "description": "Its arguments, operands resolved."
        },
        "expect": {
          "$ref": "#/$defs/Expect",
          "description": "What the value must be."
        },
        "op": {
          "description": "The op's tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "A JSON pointer into the result.",
          "type": "string"
        },
        "step": {
          "description": "The recipe step whose postcondition it evaluates.",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolName"
            },
            {
              "type": "null"
            }
          ],
          "description": "The tool, or `None` for the step's own output."
        }
      },
      "required": [
        "step",
        "args",
        "path",
        "expect"
      ],
      "type": "object"
    },
    "CommitReason": {
      "description": "Why a skill version was committed.",
      "oneOf": [
        {
          "const": "distill",
          "description": "Distilled by the librarian.",
          "type": "string"
        },
        {
          "const": "repair",
          "description": "Repaired after a failure or a retired fact.",
          "type": "string"
        },
        {
          "const": "user_edit",
          "description": "Edited by the user.",
          "type": "string"
        },
        {
          "const": "user_correction",
          "description": "Corrected by the user.",
          "type": "string"
        },
        {
          "const": "rollback",
          "description": "Rolled back.",
          "type": "string"
        },
        {
          "const": "promote",
          "description": "Promoted.",
          "type": "string"
        },
        {
          "const": "demote",
          "description": "Demoted.",
          "type": "string"
        }
      ]
    },
    "DeferReason": {
      "description": "Why a job's distillation was put off.",
      "oneOf": [
        {
          "const": "plan_cap",
          "description": "The plan share cap.",
          "type": "string"
        },
        {
          "const": "admission_refused",
          "description": "Memory admission refused the librarian.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "The librarian failed.",
          "properties": {
            "librarian_failed": {
              "properties": {
                "error": {
                  "description": "Its error.",
                  "type": "string"
                }
              },
              "required": [
                "error"
              ],
              "type": "object"
            }
          },
          "required": [
            "librarian_failed"
          ],
          "type": "object"
        },
        {
          "const": "cancelled",
          "description": "Cancelled, or left `Queued` or `Running` by a stopped runtime.",
          "type": "string"
        }
      ]
    },
    "DesktopContext": {
      "description": "The context a job ran in.",
      "properties": {
        "app_versions": {
          "description": "The apps touched and their versions.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "connectors": {
          "description": "The connectors involved.",
          "items": {
            "$ref": "#/$defs/ConnectorId"
          },
          "type": "array"
        },
        "document": {
          "description": "The document's identity, redacted.",
          "type": [
            "string",
            "null"
          ],
          "x-eileen-text": "personal"
        },
        "focused_app": {
          "description": "The focused app.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "app_versions",
        "connectors"
      ],
      "type": "object"
    },
    "DistillOutcome": {
      "description": "How a job's distillation finished.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A draft.",
          "properties": {
            "drafted": {
              "properties": {
                "held": {
                  "$ref": "#/$defs/DraftHold",
                  "description": "What is held."
                },
                "skill": {
                  "$ref": "#/$defs/SkillRef",
                  "description": "The skill."
                }
              },
              "required": [
                "skill",
                "held"
              ],
              "type": "object"
            }
          },
          "required": [
            "drafted"
          ],
          "type": "object"
        },
        {
          "const": "rejected",
          "description": "Rejected.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Skipped.",
          "properties": {
            "skipped": {
              "$ref": "#/$defs/SkipReason"
            }
          },
          "required": [
            "skipped"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Put off.",
          "properties": {
            "deferred": {
              "$ref": "#/$defs/DeferReason"
            }
          },
          "required": [
            "deferred"
          ],
          "type": "object"
        }
      ]
    },
    "DistillState": {
      "description": "One row per job in `librarian_runs` (section 2.10 item 2): idle distillation takes only jobs\nwith no row or a `Deferred` outcome. `Done { Rejected }` is final.",
      "oneOf": [
        {
          "const": "queued",
          "description": "Waiting for a batch.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "In a batch.",
          "properties": {
            "running": {
              "properties": {
                "batch": {
                  "description": "The batch.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "batch"
              ],
              "type": "object"
            }
          },
          "required": [
            "running"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finished.",
          "properties": {
            "done": {
              "properties": {
                "outcome": {
                  "$ref": "#/$defs/DistillOutcome",
                  "description": "How."
                }
              },
              "required": [
                "outcome"
              ],
              "type": "object"
            }
          },
          "required": [
            "done"
          ],
          "type": "object"
        }
      ]
    },
    "DraftHold": {
      "description": "What part of a draft is held for review.",
      "oneOf": [
        {
          "const": "none",
          "description": "Nothing.",
          "type": "string"
        },
        {
          "const": "lines",
          "description": "Some lines.",
          "type": "string"
        },
        {
          "const": "whole",
          "description": "The whole draft.",
          "type": "string"
        }
      ]
    },
    "Expect": {
      "description": "What a checked value must be. `AtLeast`, `AtLeastRel`, `Within` and `Count` take numeric\noperands only (an array is wrapped in `Len`); `Count` compares the length of the array at\n`path` with its bounds.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Equal to.",
          "properties": {
            "equals": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "equals"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Contains.",
          "properties": {
            "contains": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "contains"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "At least.",
          "properties": {
            "at_least": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "at_least"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "At least a factor of another value.",
          "properties": {
            "at_least_rel": {
              "properties": {
                "factor": {
                  "description": "The factor.",
                  "format": "double",
                  "type": "number"
                },
                "of": {
                  "$ref": "#/$defs/Operand",
                  "description": "The other value."
                }
              },
              "required": [
                "of",
                "factor"
              ],
              "type": "object"
            }
          },
          "required": [
            "at_least_rel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Within a tolerance of another value.",
          "properties": {
            "within": {
              "properties": {
                "of": {
                  "$ref": "#/$defs/Operand",
                  "description": "The other value."
                },
                "tol": {
                  "description": "The tolerance.",
                  "format": "double",
                  "type": "number"
                }
              },
              "required": [
                "of",
                "tol"
              ],
              "type": "object"
            }
          },
          "required": [
            "within"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An array's length between bounds.",
          "properties": {
            "count": {
              "properties": {
                "max": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Operand"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The greatest length."
                },
                "min": {
                  "$ref": "#/$defs/Operand",
                  "description": "The least length."
                }
              },
              "required": [
                "min"
              ],
              "type": "object"
            }
          },
          "required": [
            "count"
          ],
          "type": "object"
        },
        {
          "const": "exists",
          "description": "Present.",
          "type": "string"
        },
        {
          "const": "truthy",
          "description": "Truthy.",
          "type": "string"
        }
      ]
    },
    "FactDelta": {
      "description": "A change to the facts.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A new fact.",
          "properties": {
            "add": {
              "properties": {
                "fact": {
                  "$ref": "#/$defs/UserFact",
                  "description": "The fact."
                }
              },
              "required": [
                "fact"
              ],
              "type": "object"
            }
          },
          "required": [
            "add"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The user confirmed a fact.",
          "properties": {
            "confirm": {
              "properties": {
                "at": {
                  "$ref": "#/$defs/WallTime",
                  "description": "When."
                },
                "id": {
                  "description": "The fact.",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "at"
              ],
              "type": "object"
            }
          },
          "required": [
            "confirm"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fact retired.",
          "properties": {
            "retire": {
              "properties": {
                "id": {
                  "description": "The fact.",
                  "type": "string"
                },
                "reason": {
                  "$ref": "#/$defs/RetireReason",
                  "description": "Why."
                },
                "replaced_by": {
                  "description": "The fact that replaces it.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "retire"
          ],
          "type": "object"
        }
      ]
    },
    "FactKind": {
      "description": "The kinds of fact. Sources are `SourceStat`s, not facts; `Phrasing` names the kind in\ncommands and queries and is stored as a `PhrasingFact`.",
      "oneOf": [
        {
          "const": "user",
          "description": "About the user.",
          "type": "string"
        },
        {
          "const": "feedback",
          "description": "The user's feedback on answers.",
          "type": "string"
        },
        {
          "const": "project",
          "description": "About a project.",
          "type": "string"
        },
        {
          "const": "reference",
          "description": "A reference the user keeps.",
          "type": "string"
        },
        {
          "const": "vocabulary",
          "description": "The user's vocabulary.",
          "type": "string"
        },
        {
          "const": "phrasing",
          "description": "How the user phrases things.",
          "type": "string"
        }
      ]
    },
    "ForgetPlan": {
      "description": "Everything one forget removes. `phrasings`: every phrasing whose source turn or source job\nis in the plan; `answers`: the answers-cache rows those jobs wrote; `source_topics`: source\nstatistics topics no other job contributed to. The jobs and turns also go to\n`Persist(PurgeJobs)` for `eileen.db`.",
      "properties": {
        "answers": {
          "description": "Answers-cache rows.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blobs": {
          "description": "Blobs.",
          "items": {
            "$ref": "#/$defs/BlobRef"
          },
          "type": "array"
        },
        "facts": {
          "description": "Facts.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "incidents": {
          "description": "Incidents.",
          "items": {
            "$ref": "#/$defs/IncidentId"
          },
          "type": "array"
        },
        "jobs": {
          "description": "Jobs.",
          "items": {
            "$ref": "#/$defs/JobId"
          },
          "type": "array"
        },
        "live_sessions": {
          "description": "Live sessions to recycle.",
          "items": {
            "$ref": "#/$defs/WorkerSessionId"
          },
          "type": "array"
        },
        "phrasings": {
          "description": "Phrasings.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recordings": {
          "description": "Recordings.",
          "items": {
            "$ref": "#/$defs/RecordingId"
          },
          "type": "array"
        },
        "scenarios": {
          "description": "Saved scenarios.",
          "items": {
            "$ref": "#/$defs/ScenarioId"
          },
          "type": "array"
        },
        "skills": {
          "description": "Skills.",
          "items": {
            "$ref": "#/$defs/SkillRef"
          },
          "type": "array"
        },
        "source_topics": {
          "description": "Source statistics topics.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turns": {
          "description": "Turns.",
          "items": {
            "$ref": "#/$defs/TurnId"
          },
          "type": "array"
        }
      },
      "required": [
        "skills",
        "facts",
        "phrasings",
        "answers",
        "source_topics",
        "jobs",
        "turns",
        "blobs",
        "incidents",
        "recordings",
        "scenarios",
        "live_sessions"
      ],
      "type": "object"
    },
    "ForgetReport": {
      "description": "What a forget removed, by count.",
      "properties": {
        "answers": {
          "description": "Answers-cache rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "blobs": {
          "description": "Blobs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "facts": {
          "description": "Facts.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "incidents": {
          "description": "Incidents.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "jobs": {
          "description": "Jobs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "phrasings": {
          "description": "Phrasings.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "recordings": {
          "description": "Recordings.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scenarios": {
          "description": "Saved scenarios.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skills": {
          "description": "Skills.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "skills",
        "facts",
        "phrasings",
        "answers",
        "jobs",
        "blobs",
        "incidents",
        "recordings",
        "scenarios"
      ],
      "type": "object"
    },
    "ForgetTarget": {
      "description": "What to forget.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A skill.",
          "properties": {
            "skill": {
              "properties": {
                "id": {
                  "$ref": "#/$defs/SkillId",
                  "description": "The skill."
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "skill"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A fact.",
          "properties": {
            "fact": {
              "properties": {
                "id": {
                  "description": "The fact.",
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            }
          },
          "required": [
            "fact"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Everything about something (\"forget that I ...\").",
          "properties": {
            "about": {
              "properties": {
                "text": {
                  "description": "What.",
                  "type": "string"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "about"
          ],
          "type": "object"
        },
        {
          "const": "last_used",
          "description": "The last thing used.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A job and everything it left.",
          "properties": {
            "job": {
              "properties": {
                "job": {
                  "$ref": "#/$defs/JobId",
                  "description": "The job."
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "job"
          ],
          "type": "object"
        }
      ]
    },
    "HandoffBrief": {
      "description": "What a worker gets when a replay hands off.",
      "properties": {
        "done_steps": {
          "description": "The steps already done.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "Why.",
          "type": "string"
        },
        "skill": {
          "$ref": "#/$defs/SkillRef",
          "description": "The skill."
        },
        "step": {
          "description": "The step that failed.",
          "type": "string"
        }
      },
      "required": [
        "skill",
        "step",
        "reason",
        "done_steps"
      ],
      "type": "object"
    },
    "JobOrigin": {
      "description": "What kind of job a trajectory comes from.",
      "oneOf": [
        {
          "const": "worker",
          "description": "A worker session.",
          "type": "string"
        },
        {
          "const": "replay",
          "description": "A replayed recipe.",
          "type": "string"
        },
        {
          "const": "fast_path",
          "description": "The fast path.",
          "type": "string"
        },
        {
          "const": "act",
          "description": "A brain turn that ran `act` tools.",
          "type": "string"
        }
      ]
    },
    "LadderPolicy": {
      "description": "The promotion ladder's policy (defaults in section 2.10).",
      "properties": {
        "archive_idle_days": {
          "description": "Idle days that archive a skill (never deletion; pinned skills are never archived).",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "demote_failures_in_last5": {
          "description": "Failures in the last five uses that drop a level.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "light": {
          "$ref": "#/$defs/Thresholds",
          "description": "Light skills' thresholds."
        },
        "standard": {
          "$ref": "#/$defs/Thresholds",
          "description": "Standard skills' thresholds."
        }
      },
      "required": [
        "light",
        "standard",
        "demote_failures_in_last5",
        "archive_idle_days"
      ],
      "type": "object"
    },
    "LearnBusEvent": {
      "description": "The learning loop's bus events (dotted names `learn.skill_drafted`, `learn.verdict`, ...).\nEach distillation attempt of a job ends in exactly one of `SkillDrafted`, `DraftRejected`,\n`DistillSkipped` or `DistillDeferred`, and a job is distilled at most once.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A draft passed the linter.",
          "properties": {
            "skill_drafted": {
              "properties": {
                "held": {
                  "$ref": "#/$defs/DraftHold",
                  "description": "What is held for review."
                },
                "job": {
                  "$ref": "#/$defs/JobId",
                  "description": "The job it came from."
                },
                "skill": {
                  "$ref": "#/$defs/SkillRef",
                  "description": "The skill."
                }
              },
              "required": [
                "job",
                "skill",
                "held"
              ],
              "type": "object"
            }
          },
          "required": [
            "skill_drafted"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A draft was rejected.",
          "properties": {
            "draft_rejected": {
              "properties": {
                "job": {
                  "$ref": "#/$defs/JobId",
                  "description": "The job."
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "draft_rejected"
