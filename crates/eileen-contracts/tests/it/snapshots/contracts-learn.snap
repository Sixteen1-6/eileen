          "properties": {
            "delegate": {
              "properties": {
                "goal": {
                  "description": "What the sub-job does.",
                  "type": "string"
                },
                "inputs": {
                  "description": "Its inputs."
                }
              },
              "required": [
                "goal",
                "inputs"
              ],
              "type": "object"
            }
          },
          "required": [
            "delegate"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ask the user to confirm; never skipped by replay.",
          "properties": {
            "confirm": {
              "properties": {
                "question": {
                  "description": "The question.",
                  "type": "string"
                },
                "show": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Operand"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "What to show with it."
                }
              },
              "required": [
                "question"
              ],
              "type": "object"
            }
          },
          "required": [
            "confirm"
          ],
          "type": "object"
        }
      ]
    },
    "StepResult": {
      "description": "The result of the step the core just ran, fed back to the replay machine.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A call's result.",
          "properties": {
            "call": {
              "properties": {
                "result": {
                  "$ref": "#/$defs/ToolResult",
                  "description": "The result."
                },
                "step": {
                  "description": "The step.",
                  "type": "string"
                }
              },
              "required": [
                "step",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A check's result.",
          "properties": {
            "check": {
              "properties": {
                "passed": {
                  "description": "Whether it passed.",
                  "type": "boolean"
                },
                "step": {
                  "description": "The step.",
                  "type": "string"
                }
              },
              "required": [
                "step",
                "passed"
              ],
              "type": "object"
            }
          },
          "required": [
            "check"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The user's answer to an `ask` step.",
          "properties": {
            "answer": {
              "properties": {
                "step": {
                  "description": "The step.",
                  "type": "string"
                },
                "value": {
                  "description": "The value it resolved to."
                }
              },
              "required": [
                "step",
                "value"
              ],
              "type": "object"
            }
          },
          "required": [
            "answer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A delegated sub-job's report.",
          "properties": {
            "delegated": {
              "properties": {
                "report": {
                  "description": "The report."
                },
                "step": {
                  "description": "The step.",
                  "type": "string"
                }
              },
              "required": [
                "step",
                "report"
              ],
              "type": "object"
            }
          },
          "required": [
            "delegated"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The user's answer to a `confirm` step.",
          "properties": {
            "confirmed": {
              "properties": {
                "step": {
                  "description": "The step.",
                  "type": "string"
                },
                "yes": {
                  "description": "Whether the user said yes.",
                  "type": "boolean"
                }
              },
              "required": [
                "step",
                "yes"
              ],
              "type": "object"
            }
          },
          "required": [
            "confirmed"
          ],
          "type": "object"
        }
      ]
    },
    "Thresholds": {
      "description": "Per level: level 2 needs successes and distinct slot values, level 3 agreeing shadows plus\napproval, level 4 clean replays and a clean share of the last 20 (0: no share required).",
      "properties": {
        "l2_distinct_slot_values": {
          "description": "Level 2: distinct slot values among them.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "l2_successes": {
          "description": "Level 2: successful uses.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "l3_agreeing_shadows": {
          "description": "Level 3: agreeing shadow runs.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "l4_clean_pct_last_20": {
          "description": "Level 4: the clean share of the last 20 uses, percent.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "l4_clean_replays": {
          "description": "Level 4: clean replays.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "l2_successes",
        "l2_distinct_slot_values",
        "l3_agreeing_shadows",
        "l4_clean_replays",
        "l4_clean_pct_last_20"
      ],
      "type": "object"
    },
    "ToolCallPlan": {
      "description": "A call the replay makes.",
      "properties": {
        "args": {
          "description": "Its arguments, operands resolved, one flat object."
        },
        "op": {
          "description": "The op's tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "step": {
          "description": "The recipe step.",
          "type": "string"
        },
        "tool": {
          "$ref": "#/$defs/ToolName",
          "description": "The tool."
        }
      },
      "required": [
        "step",
        "tool",
        "args"
      ],
      "type": "object"
    },
    "Trajectory": {
      "description": "One job's record for the learning loop.",
      "properties": {
        "context": {
          "$ref": "#/$defs/DesktopContext",
          "description": "The focused app, app versions touched, document identity (redacted), connectors."
        },
        "cost": {
          "$ref": "#/$defs/Cost",
          "description": "What it cost."
        },
        "facts": {
          "description": "The ids of the facts bound into the job (its facts block).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "job_id": {
          "$ref": "#/$defs/JobId",
          "description": "The job."
        },
        "no_learn": {
          "description": "The user asked not to learn from it.",
          "type": "boolean"
        },
        "origin": {
          "$ref": "#/$defs/JobOrigin",
          "description": "What kind of job it was."
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/Outcome"
            },
            {
              "type": "null"
            }
          ],
          "description": "How it ended."
        },
        "redactions": {
          "description": "How many values were redacted.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "request": {
          "description": "What the user said.",
          "type": "string",
          "x-eileen-text": "personal"
        },
        "route": {
          "$ref": "#/$defs/Route",
          "description": "The route that ran it."
        },
        "schema": {
          "description": "The format's version.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "skills_used": {
          "description": "The skills it used.",
          "items": {
            "$ref": "#/$defs/SkillUse"
          },
          "type": "array"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/SnapshotManifest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which skill versions the session had."
        },
        "snapshot_tampered": {
          "description": "A hash or manifest mismatch: excluded from learning and statistics.",
          "type": "boolean"
        },
        "steps": {
          "description": "Its steps.",
          "items": {
            "$ref": "#/$defs/TrajectoryStep"
          },
          "type": "array"
        },
        "taint": {
          "$ref": "#/$defs/Taint",
          "description": "The observed sources the job read (section 2.12)."
        },
        "task": {
          "description": "The dispatched task.",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "job_id",
        "request",
        "task",
        "context",
        "route",
        "origin",
        "snapshot_tampered",
        "skills_used",
        "facts",
        "taint",
        "steps",
        "cost",
        "redactions",
        "no_learn"
      ],
      "type": "object"
    },
    "TrajectoryStep": {
      "description": "One step of a job.",
      "properties": {
        "app": {
          "description": "The app and version touched.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "type": [
            "array",
            "null"
          ]
        },
        "approval": {
          "description": "The user's answer, when it needed approval.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "args": {
          "description": "Its arguments, redacted.",
          "x-eileen-text": "untrusted"
        },
        "at_ms": {
          "description": "When, ms since the job started.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "call": {
          "$ref": "#/$defs/CallId",
          "description": "The call."
        },
        "ok": {
          "description": "Whether it succeeded.",
          "type": "boolean"
        },
        "op": {
          "description": "The op's tag, for tools with ops.",
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Computed by `eileen-skills`, never taken from the librarian."
        },
        "result": {
          "description": "Its result, redacted; long string leaves cut, every key and the structure kept.",
          "x-eileen-text": "untrusted"
        },
        "rung": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rung"
            },
            {
              "type": "null"
            }
          ],
          "description": "The route it took."
        },
        "schema_hash": {
          "description": "The tool's schema hash.",
          "type": "string"
        },
        "shadow_of": {
          "description": "Set only on the core's shadow checks (section 2.10 item 7): the recipe step whose\npostcondition this read evaluated; never compiled.",
          "type": [
            "string",
            "null"
          ]
        },
        "tainted": {
          "description": "Whether the job was tainted when it ran.",
          "type": "boolean"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "Its tier."
        },
        "tool": {
          "$ref": "#/$defs/ToolName",
          "description": "The tool."
        }
      },
      "required": [
        "call",
        "at_ms",
        "tool",
        "schema_hash",
        "args",
        "ok",
        "result",
        "tier",
        "provenance",
        "tainted"
      ],
      "type": "object"
    },
    "Transition": {
      "description": "What `next_level` decides for a skill.",
      "oneOf": [
        {
          "const": "stay",
          "description": "No change.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Up the ladder (level 3 also needs the user's approval).",
          "properties": {
            "promote": {
              "properties": {
                "to": {
                  "$ref": "#/$defs/Level",
                  "description": "The new level."
                }
              },
              "required": [
                "to"
              ],
              "type": "object"
            }
          },
          "required": [
            "promote"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Down the ladder.",
          "properties": {
            "demote": {
              "properties": {
                "to": {
                  "$ref": "#/$defs/Level",
                  "description": "The new level."
                }
              },
              "required": [
                "to"
              ],
              "type": "object"
            }
          },
          "required": [
            "demote"
          ],
          "type": "object"
        },
        {
          "const": "archive",
          "description": "Archived after idle days.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "On probation: one shadow run before the next replay.",
          "properties": {
            "probation": {
              "properties": {
                "reason": {
                  "description": "Why (an app version or a tool's schema hash changed).",
                  "type": "string"
                }
              },
              "required": [
                "reason"
              ],
              "type": "object"
            }
          },
          "required": [
            "probation"
          ],
          "type": "object"
        }
      ]
    },
    "UseRecord": {
      "description": "One use of a skill, for the ladder.",
      "properties": {
        "app_versions": {
          "description": "The apps touched and their versions.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "at": {
          "$ref": "#/$defs/WallTime",
          "description": "When."
        },
        "handoff": {
          "description": "Whether the replay handed off.",
          "type": "boolean"
        },
        "job": {
          "$ref": "#/$defs/JobId",
          "description": "The job."
        },
        "objective_check": {
          "description": "Whether an objective check passed.",
          "type": "boolean"
        },
        "replay": {
          "description": "Whether it was a replay.",
          "type": "boolean"
        },
        "slot_values": {
          "$ref": "#/$defs/SlotValuesOrUnknown",
          "description": "The slot values it was attributed with."
        },
        "verdict": {
          "$ref": "#/$defs/Verdict",
          "description": "Its verdict."
        }
      },
      "required": [
        "job",
        "at",
        "verdict",
        "objective_check",
        "slot_values",
        "replay",
        "handoff",
        "app_versions"
      ],
      "type": "object"
    },
    "UserFact": {
      "description": "A fact about the user.",
      "properties": {
        "confidence_pct": {
          "description": "How sure Eileen is, percent.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "confirmed": {
          "$ref": "#/$defs/WallTime",
          "description": "When it was last confirmed."
        },
        "created": {
          "$ref": "#/$defs/WallTime",
          "description": "When it was made."
        },
        "id": {
          "description": "Its id.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FactKind",
          "description": "Its kind."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "Where it traces to."
        },
        "scope": {
          "description": "A topic, repository or app the fact applies to.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_job": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The job it came from."
        },
        "source_turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The turn it came from."
        },
        "subject": {
          "description": "The subject key a correction matches (section 2.10 item 11).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The fact.",
          "type": "string",
          "x-eileen-text": "personal"
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "provenance",
        "confidence_pct",
        "created",
        "confirmed"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "A job's verdict once the regret window closes.",
      "oneOf": [
        {
          "const": "success",
          "description": "It worked.",
          "type": "string"
        },
        {
          "const": "failure",
          "description": "It did not.",
          "type": "string"
        },
        {
          "const": "unclear",
          "description": "It is not clear.",
          "type": "string"
        }
      ]
    },
    "VocabularyEntry": {
      "description": "One entry of the user's vocabulary, for the recognizer and the dictation cleaner.",
      "properties": {
        "heard_as": {
          "description": "How the recognizer tends to hear it.",
          "items": {
            "type": "string",
            "x-eileen-text": "personal"
          },
          "type": "array"
        },
        "written": {
          "description": "How it is written.",
          "type": "string",
          "x-eileen-text": "personal"
        }
      },
      "required": [
        "written",
        "heard_as"
      ],
      "type": "object"
    }
  }
}
