              "type": "object"
            }
          },
          "required": [
            "rejected"
          ],
          "type": "object"
        }
      ]
    },
    "Provenance": {
      "description": "Where a line of a skill traces to. `User`: the user's own transcript. `Worker`: an untainted\nstep's arguments. `Tool`: Eileen's schemas and descriptions. `Observed`: overlaps observed\ntext or traces only to a tainted step. Computed by `eileen-skills`, never taken from the\nlibrarian.",
      "oneOf": [
        {
          "const": "user",
          "description": "The user's own transcript.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "An untainted step's arguments.",
          "properties": {
            "worker": {
              "properties": {
                "route": {
                  "$ref": "#/$defs/Route",
