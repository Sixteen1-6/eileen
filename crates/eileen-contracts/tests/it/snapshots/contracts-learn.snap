        "message"
      ],
      "type": "object"
    },
    "McpPackage": {
      "description": "A package to install: an exact version, installed once into\n`%LOCALAPPDATA%\\eileen\\mcp\\<app>\\`.",
      "properties": {
        "identifier": {
          "description": "The package's identifier.",
          "type": "string",
          "x-eileen-text": "untrusted"
        },
        "registry_type": {
          "$ref": "#/$defs/PackageType",
          "description": "The package registry."
        },
        "version": {
          "description": "The exact version.",
          "type": "string"
        }
      },
      "required": [
        "registry_type",
        "identifier",
        "version"
      ],
      "type": "object"
    },
    "OnFail": {
      "description": "What happens when a step fails. `Fallback`: run these steps (no fallbacks of their own),\nthen re-run the failed step once and re-check it; a second failure hands off. A fallback\nstep may point to earlier main steps and earlier steps of its own fallback; no main step and\nno other fallback may point into it.",
      "oneOf": [
        {
          "const": "handoff",
          "description": "Hand the job to a worker.",
          "type": "string"
        },
        {
          "const": "retry_once",
          "description": "Retry once (idempotent ops only).",
          "type": "string"
        },
        {
          "const": "abort",
          "description": "Stop.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Run these steps, then re-run the failed step once.",
          "properties": {
            "fallback": {
              "items": {
                "$ref": "#/$defs/RecipeStep"
              },
              "type": "array"
            }
          },
          "required": [
            "fallback"
          ],
          "type": "object"
        }
      ]
    },
    "Operand": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "$slot": {
              "type": "string"
            }
          },
          "required": [
            "$slot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "$step": {
              "type": "string"
            },
            "ptr": {
              "type": "string"
            }
          },
          "required": [
            "$step",
            "ptr"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "$len": {
              "$ref": "#/$defs/Operand"
            }
          },
          "required": [
            "$len"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "$lit": true
          },
          "required": [
            "$lit"
          ],
          "type": "object"
        },
        true
      ],
      "description": "A literal, {\"$slot\": name}, {\"$step\": id, \"ptr\": pointer}, {\"$len\": operand}, or {\"$lit\": literal} for a literal of one of those shapes"
    },
    "Outcome": {
      "description": "How a job ended.",
      "properties": {
        "objective_check": {
          "description": "Whether an objective check passed (a verification hint or a skill postcondition).",
          "type": "boolean"
        },
        "signals": {
          "description": "The signals in the regret window.",
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "type": "array"
        },
