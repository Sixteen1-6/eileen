          "description": "Recognition.",
          "type": "string"
        },
        {
          "const": "turn",
          "description": "End of turn.",
          "type": "string"
        },
        {
          "const": "tts",
          "description": "Synthesis.",
          "type": "string"
        },
        {
          "const": "clone",
          "description": "Voice cloning.",
          "type": "string"
        },
        {
          "const": "embed",
          "description": "The L2 embedding model.",
          "type": "string"
        },
        {
          "const": "speaker",
          "description": "The speaker check.",
          "type": "string"
        }
      ]
    },
    "PauseCause": {
      "description": "Why the live re-check let an item go.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Available memory stayed under the reserve for 30 s.",
          "properties": {
            "memory_low": {
              "properties": {
                "largest": {
                  "description": "The biggest process that is not Eileen's, and its working set in MB.",
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "string",
                      "x-eileen-text": "personal"
                    },
                    {
                      "format": "uint32",
                      "minimum": 0,
                      "type": "integer"
                    }
                  ],
                  "type": [
                    "array",
                    "null"
                  ]
                }
              },
              "type": "object"
            }
          },
          "required": [
            "memory_low"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Paging stayed above `memory.max_paging_kb_s` for 30 s.",
          "properties": {
            "paging": {
              "properties": {
                "kb_s": {
                  "description": "The 30 s average, KB/s.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kb_s"
              ],
              "type": "object"
            }
          },
          "required": [
            "paging"
          ],
          "type": "object"
        },
        {
          "const": "battery_saver",
          "description": "Battery saver is on.",
          "type": "string"
        }
      ]
    },
    "PowerState": {
      "description": "The power source and battery saver.",
      "properties": {
        "battery_saver": {
          "description": "Battery saver is on.",
          "type": "boolean"
        },
        "has_battery": {
          "description": "The PC has a battery.",
          "type": "boolean"
        },
        "on_battery": {
          "description": "It runs on the battery now.",
          "type": "boolean"
        }
      },
      "required": [
