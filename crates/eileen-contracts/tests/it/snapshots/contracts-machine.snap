          "$ref": "#/$defs/StagedState",
          "description": "Its state."
        }
      },
      "required": [
        "feature",
        "state",
        "sentence"
      ],
      "type": "object"
    },
    "StagedState": {
      "description": "A staged feature's state.",
      "oneOf": [
        {
          "const": "off",
          "description": "Not used.",
          "type": "string"
        },
        {
          "const": "on_demand",
          "description": "Used when the user asks for it.",
          "type": "string"
        },
        {
          "const": "shadow",
          "description": "Measured but not acted on.",
          "type": "string"
        },
        {
          "const": "on",
          "description": "In use.",
          "type": "string"
        }
      ]
    },
    "UsualMemory": {
      "description": "The PC's usual memory: `samples::usual` over 7 days of hourly summaries (section 2.16). What\nthe PC would usually have free without Eileen's own extras is `available_mb` plus\n`plan_items_mb`.",
      "properties": {
        "available_mb": {
          "description": "The 25th percentile of the hourly medians of available memory, MB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "headroom_p10_mb": {
          "description": "The usual 10th percentile of commit headroom, MB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "hours": {
          "description": "The qualifying hours behind it; 0 means the first minute's reading after start.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "plan_items_mb": {
          "description": "The median of what the plan's own items held at those samples, MB.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "hours",
        "available_mb",
        "plan_items_mb",
        "headroom_p10_mb"
      ],
      "type": "object"
    }
  }
}
