      "description": "A feature shown with its state and reason, not chosen by the plan (row 13).",
      "properties": {
        "feature": {
          "description": "The feature, such as `speaker_check`.",
          "type": "string"
        },
        "sentence": {
          "description": "Its state and reason in words, with any measured numbers, from Eileen's own template.",
          "type": "string"
        },
