          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Playback paused.",
          "properties": {
            "paused": {
              "properties": {
                "clause": {
                  "description": "Its clause.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "samples_played": {
                  "description": "Samples of that clause played before the pause.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak",
                "clause",
                "samples_played"
              ],
              "type": "object"
            }
          },
          "required": [
            "paused"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Playback stopped.",
          "properties": {
            "stopped": {
              "properties": {
                "clause": {
                  "description": "Its clause.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                "samples_played": {
                  "description": "Samples of that clause played before the stop.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak",
                "clause",
                "samples_played"
              ],
              "type": "object"
            }
          },
          "required": [
            "stopped"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Every queued sample of the utterance was played.",
          "properties": {
            "drained": {
              "properties": {
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak"
              ],
              "type": "object"
            }
          },
          "required": [
            "drained"
          ],
          "type": "object"
        },
        {
          "const": "device_changed",
          "description": "The output device changed.",
          "type": "string"
        },
        {
          "const": "stalled",
          "description": "The device stopped taking samples.",
          "type": "string"
        }
      ]
    },
