        "is_error",
        "duration_ms"
      ],
      "type": "object"
    },
    "UrlCtx": {
      "description": "What the core supplies from its own state for each URL check.",
      "properties": {
        "built_by_eileen": {
          "description": "The core's own code built the URL: a grammar entry or resolver, the video URL builder, a\nreplay step's pointer into an `apps_recent` url.",
          "type": "boolean"
        },
        "context_complete": {
          "description": "False when a browser window there had no readable address bar.",
          "type": "boolean"
        },
        "context_hosts": {
          "description": "Hosts whose pages are in the deciding context (section 2.12).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "task": {
          "description": "The job's dispatched task, subtasks and subquestions, once it passed.",
          "type": [
            "string",
            "null"
          ],
          "x-eileen-text": "personal"
        },
        "transcript": {
          "description": "The authorizing turn's normalised final transcript.",
          "type": "string",
          "x-eileen-text": "personal"
        },
        "untainted_args": {
          "description": "The string arguments of the job's untainted steps.",
          "items": {
            "type": "string",
            "x-eileen-text": "personal"
          },
          "type": "array"
        }
      },
      "required": [
        "built_by_eileen",
        "transcript",
        "untainted_args",
        "context_hosts",
        "context_complete"
      ],
      "type": "object"
    },
    "UrlFact": {
      "description": "Built by the runtime for each URL in a call, the way it builds `PathFact`s, so the URL rule\nneeds no IO.",
      "properties": {
        "arg": {
          "description": "The argument it came from.",
          "type": "string"
        },
        "host": {
          "description": "Its host, when it parsed.",
          "type": [
            "string",
            "null"
          ]
        },
        "in_index": {
          "description": "Verbatim in the media history or the recent-work index (rule 1).",
          "type": "boolean"
        },
        "url": {
          "description": "The URL.",
          "type": "string",
          "x-eileen-text": "personal"
        },
        "visited": {
          "description": "The full URL, path and query included, is in the media history or the ledger's browser\nlines (rule 3).",
          "type": "boolean"
        }
      },
      "required": [
        "arg",
        "url",
        "in_index",
        "visited"
      ],
      "type": "object"
    },
    "UrlRefusal": {
      "description": "Why a URL is not vouched for.",
      "oneOf": [
        {
          "const": "unparsed",
          "description": "It did not parse.",
          "type": "string"
        },
        {
          "const": "host_not_named",
          "description": "The user did not name its host.",
          "type": "string"
        },
        {
          "const": "not_verbatim",
          "description": "It does not appear verbatim where it must.",
          "type": "string"
        },
        {
          "const": "visited_host_only",
          "description": "Only its host was visited, not the URL.",
          "type": "string"
        },
        {
          "const": "context_host",
          "description": "Its host is a page in the deciding context.",
          "type": "string"
        },
        {
          "const": "context_incomplete",
          "description": "The deciding context is incomplete.",
          "type": "string"
        }
      ]
    },
    "UrlVerdict": {
      "description": "The URL rule's answer.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The URL may be opened, by this rule.",
          "properties": {
            "vouched": {
              "$ref": "#/$defs/VouchRule"
            }
          },
          "required": [
            "vouched"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The URL is not vouched for, for this reason.",
          "properties": {
            "not_vouched": {
              "$ref": "#/$defs/UrlRefusal"
            }
          },
          "required": [
            "not_vouched"
          ],
          "type": "object"
        }
      ]
    },
    "UserInput": {
      "description": "Input from the user's own hands and keyboard, never from screen or model text. The shell\nemits `Approve`, `Deny` and an unmuting `SetMute` or `ToggleMute` from a hotkey or the tray\nonly when Raw Input saw the keys or the click come from a device.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Mute or unmute.",
          "properties": {
            "set_mute": {
              "type": "boolean"
            }
          },
          "required": [
            "set_mute"
          ],
          "type": "object"
        },
        {
          "const": "toggle_mute",
          "description": "Toggle mute.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Approve a question.",
          "properties": {
            "approve": {
              "$ref": "#/$defs/ApprovalId"
            }
          },
          "required": [
            "approve"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Deny a question.",
          "properties": {
            "deny": {
              "$ref": "#/$defs/ApprovalId"
            }
          },
          "required": [
            "deny"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cancel a job.",
          "properties": {
            "cancel_job": {
              "$ref": "#/$defs/JobId"
            }
          },
          "required": [
            "cancel_job"
          ],
          "type": "object"
        },
        {
          "const": "pause_desktop_jobs",
          "description": "Pause every desktop job.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Admit one job queued for memory (rule 4 of section 2.5).",
          "properties": {
            "start_anyway": {
              "$ref": "#/$defs/JobId"
            }
          },
          "required": [
            "start_anyway"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Typing in Eileen's own UI.",
          "properties": {
            "typed": {
              "properties": {
                "text": {
                  "description": "The text.",
                  "type": "string",
                  "x-eileen-text": "personal"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "typed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`eileen say` and other command-line input.",
          "properties": {
            "cli": {
              "properties": {
                "text": {
                  "description": "The text.",
                  "type": "string",
                  "x-eileen-text": "personal"
                }
              },
              "required": [
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "cli"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A HUD line.",
          "properties": {
            "hud": {
              "properties": {
                "input": {
                  "$ref": "#/$defs/HudInput",
                  "description": "What was clicked."
                },
                "physical": {
                  "description": "Whether the click came with a Raw Input device handle.",
                  "type": "boolean"
                }
              },
              "required": [
                "input",
                "physical"
              ],
              "type": "object"
            }
          },
          "required": [
            "hud"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The dictation key went down or up.",
          "properties": {
            "dictation_key": {
              "$ref": "#/$defs/KeyEdge"
            }
          },
          "required": [
            "dictation_key"
          ],
          "type": "object"
        },
        {
          "const": "save_incident",
          "description": "Save an incident.",
          "type": "string"
        },
        {
          "const": "save_scenario",
          "description": "Save the last request as a scenario.",
          "type": "string"
        }
      ]
    },
    "Verification": {
      "description": "How a server checked a call's effect.",
      "properties": {
        "kind": {
          "description": "What was checked, for example `value_read_back`.",
          "type": "string"
        },
        "observed": {
          "description": "What it saw.",
          "x-eileen-text": "untrusted"
        }
      },
      "required": [
        "kind",
        "observed"
      ],
      "type": "object"
    },
    "VouchRule": {
      "description": "Why a URL is vouched for.",
      "oneOf": [
        {
          "const": "built_by_eileen",
          "description": "Eileen's own code built it.",
          "type": "string"
        },
        {
          "const": "in_index",
          "description": "It is in the media history or the recent-work index.",
          "type": "string"
        },
        {
          "const": "named_host",
          "description": "The user named its host.",
          "type": "string"
        },
        {
          "const": "visited",
          "description": "The user visited it.",
          "type": "string"
        }
      ]
    }
  }
}
