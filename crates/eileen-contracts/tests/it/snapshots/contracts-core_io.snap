          "description": "Added by the runtime before the core sees the call.",
          "items": {
            "$ref": "#/$defs/PathFact"
          },
          "type": "array"
        },
        "tool": {
          "$ref": "#/$defs/ToolName",
          "description": "The tool."
        },
