---
source: crates/eileen-contracts/tests/it/schemas.rs
---
{
  "definitions": {
    "ActivityEvent": {
      "description": "What the user and the PC are doing.",
      "oneOf": [
        {
          "const": "physical_input",
          "description": "From Raw Input; at most one per 250 ms; carries no key or position.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Loopback energy Eileen's own stream does not explain, or a media session playing.",
          "properties": {
            "other_audio": {
              "properties": {
                "playing": {
                  "description": "Whether other audio is playing.",
                  "type": "boolean"
                }
              },
              "required": [
                "playing"
              ],
              "type": "object"
            }
          },
          "required": [
            "other_audio"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Another app is using the microphone.",
          "properties": {
            "mic_in_use_elsewhere": {
              "type": "boolean"
            }
          },
          "required": [
            "mic_in_use_elsewhere"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The session is locked.",
          "properties": {
            "session_locked": {
              "type": "boolean"
            }
          },
          "required": [
            "session_locked"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The presentation state changed.",
          "properties": {
            "presentation": {
              "$ref": "#/$defs/PresentationState"
            }
          },
          "required": [
            "presentation"
          ],
          "type": "object"
        }
      ]
    },
    "ApprovalRow": {
      "description": "One approval question and how it was resolved, in the `approvals` table.",
      "properties": {
        "allowed": {
          "description": "The answer; `None` while open.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "approval": {
          "$ref": "#/$defs/ApprovalId",
          "description": "The question."
        },
        "asked": {
          "$ref": "#/$defs/WallTime",
          "description": "When it was asked."
        },
        "by": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalSource"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which form of the user's input resolved it."
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The job that asked, if any."
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/WallTime"
            },
            {
              "type": "null"
            }
          ],
          "description": "When it was resolved."
        },
        "summary": {
          "description": "What the user was shown.",
          "type": "string"
        },
        "tier": {
          "$ref": "#/$defs/Tier",
          "description": "The tier of the call."
        }
      },
      "required": [
        "approval",
        "tier",
        "summary",
        "asked"
      ],
      "type": "object"
    },
    "AudioCmd": {
      "description": "To the audio driver.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Start or stop sending microphone audio to the speech process.",
          "properties": {
            "set_capture": {
              "type": "boolean"
            }
          },
          "required": [
            "set_capture"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Duck other audio by this many decibels (negative).",
          "properties": {
            "duck": {
              "properties": {
                "db": {
                  "description": "The gain change, dB.",
                  "format": "int8",
                  "maximum": 127,
                  "minimum": -128,
                  "type": "integer"
                }
              },
              "required": [
                "db"
              ],
              "type": "object"
            }
          },
          "required": [
            "duck"
          ],
          "type": "object"
        },
        {
          "const": "unduck",
          "description": "Undo the duck.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "Pause an utterance.",
          "properties": {
            "pause": {
              "properties": {
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak"
              ],
              "type": "object"
            }
          },
          "required": [
            "pause"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Resume an utterance.",
          "properties": {
            "resume": {
              "properties": {
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak"
              ],
              "type": "object"
            }
          },
          "required": [
            "resume"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Stop an utterance.",
          "properties": {
            "stop": {
              "properties": {
                "speak": {
                  "$ref": "#/$defs/SpeakId",
                  "description": "The utterance."
                }
              },
              "required": [
                "speak"
              ],
              "type": "object"
            }
          },
          "required": [
            "stop"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Play a cached phrase.",
          "properties": {
            "play_phrase": {
              "properties": {
                "key": {
                  "description": "The phrase cache key.",
                  "type": "string"
                },
                "voice": {
                  "description": "The voice it was rendered in.",
                  "type": "string"
                }
              },
              "required": [
                "key",
                "voice"
              ],
              "type": "object"
            }
          },
          "required": [
            "play_phrase"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Play an earcon.",
          "properties": {
            "earcon": {
              "$ref": "#/$defs/Earcon"
            }
          },
          "required": [
            "earcon"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Record from the microphone.",
          "properties": {
            "record": {
              "properties": {
                "purpose": {
                  "$ref": "#/$defs/RecordPurpose",
                  "description": "What for."
                },
                "seconds": {
                  "description": "How long.",
                  "format": "uint16",
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "seconds",
                "purpose"
              ],
              "type": "object"
            }
          },
          "required": [
            "record"
          ],
          "type": "object"
        }
      ]
    },
    "Caller": {
      "description": "Where a tool call's reply goes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A shim connection to the dispatcher pipe.",
          "properties": {
            "shim": {
              "properties": {
                "connection": {
                  "description": "The connection, numbered by the dispatcher.",
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "role": {
                  "$ref": "#/$defs/ShimRole",
                  "description": "The role its hello named."
                }
              },
              "required": [
                "connection",
                "role"
              ],
              "type": "object"
            }
          },
          "required": [
            "shim"
          ],
          "type": "object"
        },
        {
          "const": "internal",
          "description": "The core itself, a replay or the fast path.",
          "type": "string"
        }
      ]
    },
    "Content": {
      "description": "One block of a tool result. Never structured content beside an image: models see `output`\nas one JSON text block.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Text.",
          "properties": {
            "text": {
              "type": "string",
              "x-eileen-text": "untrusted"
            }
          },
          "required": [
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image.",
          "properties": {
            "image": {
              "properties": {
                "base64": {
                  "description": "Its bytes, base64.",
                  "type": "string"
                },
                "mime": {
                  "description": "Its media type, for example `image/jpeg`.",
                  "type": "string"
                }
              },
              "required": [
                "mime",
                "base64"
              ],
              "type": "object"
            }
          },
          "required": [
            "image"
          ],
          "type": "object"
        }
      ]
    },
    "Earcon": {
      "description": "A short non-speech sound.",
      "oneOf": [
        {
          "const": "routed",
          "description": "The request was routed to the brain or a job.",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Something finished.",
          "type": "string"
        },
        {
          "const": "attention",
          "description": "Something needs the user.",
          "type": "string"
        },
        {
          "const": "error",
          "description": "Something failed.",
          "type": "string"
        },
        {
          "const": "muted",
          "description": "The microphone was muted.",
          "type": "string"
        },
        {
          "const": "unmuted",
          "description": "The microphone was unmuted.",
          "type": "string"
        }
      ]
    },
    "Effect": {
      "description": "Everything the core asks the drivers to do.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "To the speech process.",
          "properties": {
            "speech": {
              "$ref": "#/$defs/SpeechCmd"
            }
          },
          "required": [
            "speech"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To the audio driver.",
          "properties": {
            "audio": {
              "$ref": "#/$defs/AudioCmd"
            }
          },
          "required": [
            "audio"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To the brain driver; every command names a slot.",
          "properties": {
            "brain": {
              "$ref": "#/$defs/BrainCmd"
            }
          },
          "required": [
            "brain"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To a worker session.",
          "properties": {
            "worker": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/WorkerSessionId"
                },
                {
                  "$ref": "#/$defs/WorkerCmd"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "worker"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The answer to a gating hook request.",
          "properties": {
            "hook": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/WorkerSessionId"
                },
                {
                  "$ref": "#/$defs/HookReply"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "hook"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Forward a call to a connector.",
          "properties": {
            "tool_forward": {
              "properties": {
                "args": {
                  "description": "The arguments, rebuilt by the dispatcher."
                },
                "call": {
                  "$ref": "#/$defs/CallId",
                  "description": "The call."
                },
                "connector": {
                  "$ref": "#/$defs/ConnectorId",
                  "description": "Where it goes."
                },
                "deadline_ms": {
                  "description": "How long the connector has.",
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "tool": {
                  "$ref": "#/$defs/ToolName",
                  "description": "The tool."
                }
              },
              "required": [
                "call",
                "connector",
                "tool",
                "args",
                "deadline_ms"
              ],
              "type": "object"
            }
          },
          "required": [
            "tool_forward"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Reply to a caller.",
          "properties": {
            "tool_reply": {
              "properties": {
                "call": {
                  "$ref": "#/$defs/CallId",
                  "description": "The call."
                },
                "caller": {
                  "$ref": "#/$defs/Caller",
                  "description": "Who asked."
                },
                "result": {
                  "$ref": "#/$defs/ToolResult",
                  "description": "The result."
                }
              },
              "required": [
                "caller",
                "call",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "tool_reply"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To a sidecar's client.",
          "properties": {
            "sidecar": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/SidecarId"
                },
                {
                  "$ref": "#/$defs/SidecarCmd"
                }
              ],
              "type": "array"
            }
          },
          "required": [
            "sidecar"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A full HUD snapshot; the driver rate-limits to 10 per second.",
          "properties": {
            "hud": {
              "$ref": "#/$defs/HudState"
            }
          },
          "required": [
            "hud"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To the learning store.",
          "properties": {
            "learn": {
              "$ref": "#/$defs/LearnCmd"
            }
          },
          "required": [
            "learn"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To the settings driver.",
          "properties": {
            "settings": {
              "$ref": "#/$defs/SettingsCmd"
            }
          },
          "required": [
            "settings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "To the store.",
          "properties": {
            "persist": {
              "$ref": "#/$defs/Record"
            }
          },
          "required": [
            "persist"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Publish on the bus.",
          "properties": {
            "emit": {
              "$ref": "#/$defs/BusEvent"
            }
          },
          "required": [
            "emit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Set a timer.",
          "properties": {
            "set_timer": {
              "properties": {
                "at": {
                  "$ref": "#/$defs/MonoTime",
                  "description": "When it fires."
                },
                "id": {
                  "$ref": "#/$defs/TimerId",
                  "description": "The timer."
                }
              },
              "required": [
                "id",
                "at"
              ],
              "type": "object"
            }
          },
          "required": [
            "set_timer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Cancel a timer.",
          "properties": {
            "cancel_timer": {
              "$ref": "#/$defs/TimerId"
            }
          },
          "required": [
            "cancel_timer"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Capture an incident.",
          "properties": {
            "incident": {
              "$ref": "#/$defs/IncidentTrigger"
            }
          },
          "required": [
            "incident"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Show a toast.",
          "properties": {
            "notify": {
              "$ref": "#/$defs/Toast"
            }
          },
          "required": [
            "notify"
          ],
          "type": "object"
        }
      ]
    },
    "EffectFamily": {
      "description": "The families of [`Effect`] a component can accept (`Component::accepts`).",
      "oneOf": [
        {
          "const": "speech",
          "description": "`Effect::Speech`.",
          "type": "string"
        },
        {
          "const": "audio",
          "description": "`Effect::Audio`.",
          "type": "string"
        },
        {
          "const": "brain",
          "description": "`Effect::Brain`.",
          "type": "string"
        },
        {
          "const": "worker",
          "description": "`Effect::Worker`.",
          "type": "string"
        },
        {
          "const": "hook",
          "description": "`Effect::Hook`.",
          "type": "string"
        },
        {
          "const": "tool_forward",
          "description": "`Effect::ToolForward`.",
          "type": "string"
        },
        {
          "const": "tool_reply",
          "description": "`Effect::ToolReply`.",
          "type": "string"
        },
        {
          "const": "sidecar",
          "description": "`Effect::Sidecar`.",
          "type": "string"
        },
        {
          "const": "hud",
          "description": "`Effect::Hud`.",
          "type": "string"
        },
        {
          "const": "learn",
          "description": "`Effect::Learn`.",
          "type": "string"
        },
        {
          "const": "settings",
          "description": "`Effect::Settings`.",
          "type": "string"
        },
        {
          "const": "persist",
          "description": "`Effect::Persist`.",
          "type": "string"
        },
        {
          "const": "emit",
          "description": "`Effect::Emit`.",
          "type": "string"
        },
        {
          "const": "timer",
          "description": "`Effect::SetTimer` and `Effect::CancelTimer`.",
          "type": "string"
        },
        {
          "const": "incident",
          "description": "`Effect::Incident`.",
          "type": "string"
        },
        {
          "const": "notify",
          "description": "`Effect::Notify`.",
          "type": "string"
        }
      ]
    },
    "Envelope_BusEvent": {
      "description": "Every bus event, input and effect travels in this envelope. `seq` is the core-wide replay\norder.",
      "properties": {
        "at": {
          "$ref": "#/$defs/WallTime",
          "description": "Wall-clock time when it was made."
        },
        "body": {
          "$ref": "#/$defs/BusEvent",
          "description": "What it carries."
        },
        "ctx": {
          "$ref": "#/$defs/TraceCtx",
          "description": "Its correlation."
        },
        "mono": {
          "$ref": "#/$defs/MonoTime",
          "description": "Monotonic time when it was made."
        },
        "seq": {
          "description": "The core-wide replay order.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "at",
        "mono",
        "ctx",
        "body"
      ],
      "type": "object"
    },
    "Envelope_Effect": {
      "description": "Every bus event, input and effect travels in this envelope. `seq` is the core-wide replay\norder.",
      "properties": {
        "at": {
          "$ref": "#/$defs/WallTime",
          "description": "Wall-clock time when it was made."
        },
        "body": {
          "$ref": "#/$defs/Effect",
          "description": "What it carries."
        },
        "ctx": {
          "$ref": "#/$defs/TraceCtx",
          "description": "Its correlation."
        },
        "mono": {
          "$ref": "#/$defs/MonoTime",
          "description": "Monotonic time when it was made."
        },
        "seq": {
          "description": "The core-wide replay order.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "at",
        "mono",
        "ctx",
        "body"
      ],
      "type": "object"
    },
    "Envelope_Input": {
      "description": "Every bus event, input and effect travels in this envelope. `seq` is the core-wide replay\norder.",
      "properties": {
        "at": {
          "$ref": "#/$defs/WallTime",
          "description": "Wall-clock time when it was made."
        },
        "body": {
          "$ref": "#/$defs/Input",
          "description": "What it carries."
        },
        "ctx": {
          "$ref": "#/$defs/TraceCtx",
          "description": "Its correlation."
        },
        "mono": {
          "$ref": "#/$defs/MonoTime",
          "description": "Monotonic time when it was made."
        },
        "seq": {
          "description": "The core-wide replay order.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "seq",
        "at",
        "mono",
        "ctx",
        "body"
      ],
      "type": "object"
    },
    "GitFact": {
      "description": "The repository a git command will use (section 2.12, \"Git runs code too\"), found by the\nruntime by walking up from the command's working folder to the first `.git` entry, never by\nrunning git.",
      "properties": {
        "command": {
          "description": "The index of the git command within the command line.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "git_dir": {
          "description": "The git directory.",
          "type": "string",
          "x-eileen-text": "personal"
        },
        "has_hooks": {
          "description": "Whether it has hooks.",
          "type": "boolean"
        },
        "job_repo": {
          "description": "Whether it is the job's own repository.",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "git_dir",
        "job_repo",
        "has_hooks"
      ],
      "type": "object"
    },
    "IncidentTrigger": {
      "description": "Why an incident is captured.",
      "oneOf": [
        {
          "const": "user_report",
          "description": "The user said \"something went wrong\" or pressed the report hotkey.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A `never!` or `always!` soft assertion failed.",
          "properties": {
            "soft_assertion": {
              "properties": {
                "site": {
                  "description": "The assertion's site name.",
                  "type": "string"
                }
              },
              "required": [
                "site"
              ],
              "type": "object"
            }
          },
          "required": [
            "soft_assertion"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A component stopped answering.",
          "properties": {
            "hang": {
              "properties": {
                "component": {
                  "description": "The component.",
                  "type": "string"
                }
              },
              "required": [
                "component"
              ],
              "type": "object"
            }
          },
          "required": [
            "hang"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A component crashed.",
          "properties": {
            "crash": {
              "properties": {
                "component": {
                  "description": "The component.",
                  "type": "string"
                }
              },
              "required": [
                "component"
              ],
              "type": "object"
            }
          },
          "required": [
            "crash"
          ],
