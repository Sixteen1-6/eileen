          "type": "string"
        }
      ]
    },
    "PathClass": {
      "description": "The class of a path, tried in this order, first match wins (section 2.12): `Credential`,\n`BrowserProfile`, `GitInternals`, `SkillSnapshot`, `JobFolder`, `JobTemp`, `EileenData`,\n`Toolchain`, `Elsewhere`.",
      "oneOf": [
        {
          "const": "job_folder",
          "description": "The job's own folders.",
          "type": "string"
        },
        {
          "const": "job_temp",
          "description": "The job's temporary folder.",
          "type": "string"
        },
        {
          "const": "git_internals",
          "description": "A `.git` path component inside the job's own folders, and the job's own git and common\ndirectories.",
          "type": "string"
        },
        {
          "const": "skill_snapshot",
          "description": "The session's learned-skill snapshot.",
          "type": "string"
        },
        {
          "const": "toolchain",
          "description": "A toolchain folder.",
          "type": "string"
        },
        {
          "const": "eileen_data",
          "description": "Eileen's own data folder.",
          "type": "string"
        },
        {
          "const": "credential",
          "description": "A credential file or folder.",
          "type": "string"
        },
        {
          "const": "browser_profile",
          "description": "A browser profile.",
          "type": "string"
        },
        {
          "const": "elsewhere",
          "description": "Anywhere else.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "A glob or an unresolved variable: the command is unparseable.",
          "type": "string"
        }
      ]
    },
    "PathFact": {
      "description": "Built by the runtime for each path argument of a file tool, of a shell command (from the\ntokenizer's path positions; `access` says whether the command reads or writes it) and of an\nEileen tool field marked `x-eileen-path`.",
      "properties": {
        "access": {
          "$ref": "#/$defs/PathAccess",
          "description": "How the call uses it."
        },
        "arg": {
          "description": "The argument it came from.",
          "type": "string"
        },
        "canonical": {
          "description": "The canonical path.",
          "type": "string",
          "x-eileen-text": "personal"
        },
        "class": {
          "$ref": "#/$defs/PathClass",
          "description": "Its class, most specific first."
        },
        "git_component": {
          "description": "A component is a git directory or pointer file by the `protectNTFS` rule of section\n2.12; outside `GitInternals` it keeps its class and raises a write to tier 2, HUD only.",
          "type": "boolean"
        },
        "opens_web": {
          "description": "Its registered handler is a web browser, or it is a `.url` or `.website` file.",
          "type": "boolean"
        },
        "runs_code": {
          "description": "An executable, script, installer or a shortcut to one.",
          "type": "boolean"
        }
      },
      "required": [
        "arg",
        "class",
        "access",
        "canonical",
        "runs_code",
        "opens_web",
        "git_component"
      ],
      "type": "object"
    },
    "PlaybackEvent": {
      "description": "Playback accounting from the audio driver.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Samples handed to the device, at most every 50 ms.",
