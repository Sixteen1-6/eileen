            "string",
            "null"
          ]
        },
        "urls": {
          "description": "Likewise, for every URL in the arguments (section 2.12, \"One URL rule\").",
          "items": {
            "$ref": "#/$defs/UrlFact"
          },
          "type": "array"
        }
      },
      "required": [
        "caller",
        "origin",
        "tool",
        "args",
        "paths",
        "urls"
      ],
      "type": "object"
